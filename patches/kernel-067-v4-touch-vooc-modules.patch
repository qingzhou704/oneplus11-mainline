+						      OPLUS_SM8550_BATT_SET_COOL_DOWN,
+						      level);
+		mutex_unlock(&battmgr->lock);
+	}
+	mutex_unlock(&qcom_battmgr_vooc_lock);
+	return 0;
+}
+
+static const struct kernel_param_ops qcom_battmgr_vooc_cool_ops = {
+	.set = qcom_battmgr_vooc_cool_set,
+	.get = param_get_uint,
+};
+module_param_cb(vooc_cool_down, &qcom_battmgr_vooc_cool_ops, &vooc_cool_down, 0644);
 MODULE_PARM_DESC(vooc_cool_down, "SUPERVOOC current level passed to the ADSP, 0 for its maximum");
 
