 		goto error;
 	}
@@ -555,6 +758,16 @@ static irqreturn_t syna_irq(int irq, void *data)
 		ret = -EPIPE;
 		goto error;
 	}
+	if (ts->gesture_active) {
+		if (ts->payload_length >= SYNA_REPORT_PREFIX_SIZE &&
+		    ts->message[SYNA_HEADER_SIZE] == SYNA_GESTURE_DOUBLE_TAP) {
+			input_report_key(ts->input, KEY_WAKEUP, 1);
+			input_sync(ts->input);
+			input_report_key(ts->input, KEY_WAKEUP, 0);
