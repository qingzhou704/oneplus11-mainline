+static DEFINE_MUTEX(qcom_battmgr_vooc_lock);
+static struct qcom_battmgr *qcom_battmgr_vooc_dev;
+
 static bool vooc_allowed;
-module_param_named(vooc, vooc_allowed, bool, 0644);
+static unsigned int vooc_cool_down;
+
+static int qcom_battmgr_vooc_param_set(const char *val, const struct kernel_param *kp)
+{
+	struct qcom_battmgr *battmgr;
+	bool allow, prev;
+	int ret;
+
+	ret = kstrtobool(val, &allow);
+	if (ret)
+		return ret;
+
+	mutex_lock(&qcom_battmgr_vooc_lock);
+	prev = READ_ONCE(vooc_allowed);
+	WRITE_ONCE(vooc_allowed, allow);
+	battmgr = qcom_battmgr_vooc_dev;
+	if (battmgr) {
+		if (!prev && allow) {
+			mutex_lock(&battmgr->lock);
+			battmgr->oplus.vooc.blocked = false;
+			battmgr->oplus.vooc.retried = false;
+			mutex_unlock(&battmgr->lock);
+		}
+		mod_delayed_work(system_power_efficient_wq,
+				 &battmgr->vooc_check_work, 0);
+	}
+	mutex_unlock(&qcom_battmgr_vooc_lock);
+	return 0;
+}
+
+static const struct kernel_param_ops qcom_battmgr_vooc_ops = {
+	.set = qcom_battmgr_vooc_param_set,
+	.get = param_get_bool,
+};
+module_param_cb(vooc, &qcom_battmgr_vooc_ops, &vooc_allowed, 0644);
 MODULE_PARM_DESC(vooc, "Allow SUPERVOOC on OnePlus SM8550 boards with USB connector thermistors");
 
-static unsigned int vooc_cool_down;
