+		enable_irq(client->irq);
+	}
 	syna_active_ts = ts;
 	mutex_unlock(&syna_active_lock);
 	ret = devm_add_action_or_reset(dev, syna_clear_active, ts);
@@ -715,17 +936,26 @@ static int syna_suspend(struct device *dev)
 {
 	struct i2c_client *client = to_i2c_client(dev);
 	struct syna_tcm *ts = i2c_get_clientdata(client);
-	int ret;
+	int ret = 0;
 
+	mutex_lock(&syna_active_lock);
+	ts->system_suspended = true;
 	disable_irq(client->irq);
 	mutex_lock(&ts->lock);
-	ret = syna_exec_command(ts, SYNA_CMD_ENTER_DEEP_SLEEP, NULL, 0);
-	if (!ret)
