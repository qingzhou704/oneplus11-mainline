-	if (ret)
-		goto out;
-	ret = syna_check_app_info(ts, &info);
-	if (ret)
-		goto out;
-	if (le16_to_cpu(info.max_x) != ts->max_x ||
-	    le16_to_cpu(info.max_y) != ts->max_y ||
