 static void amb670yf07_remove(struct mipi_dsi_device *dsi)
 {
 	struct amb670yf07 *ctx = mipi_dsi_get_drvdata(dsi);
 
+	mutex_lock(&amb670yf07_active_lock);
+	if (amb670yf07_active == ctx)
+		amb670yf07_active = NULL;
+	mutex_unlock(&amb670yf07_active_lock);
+
 	drm_panel_disable(&ctx->panel);
 	drm_panel_unprepare(&ctx->panel);
 	drm_panel_remove(&ctx->panel);
@@ -376,5 +560,5 @@ static struct mipi_dsi_driver amb670yf07_driver = {
 };
