@@ -346,15 +520,25 @@ static int amb670yf07_probe(struct mipi_dsi_device *dsi)
 		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight), "failed to create backlight\n");
 	drm_panel_add(&ctx->panel);
