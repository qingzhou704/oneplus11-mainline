From afebf25c6b94dadb31f9186fe12cf613e2ec802a Mon Sep 17 00:00:00 2001
From: OnePlus 11 mainline port <noreply@localhost>
Date: Sun, 8 Nov 2026 13:23:04 +0800
Subject: [PATCH 05/10] arm64: dts: qcom: sm8550-oneplus-salami: USB connector
 thermistors

Stock oplus,battery reads three 100k NTCs on PM8550B through the PMK8550
ADC: usb_temp_adc (0x74b), usb_supplementary_temp_adc (0x749) and
subboard_temp_adc (0x74c), with gpio5/gpio10/gpio6 left high-impedance.
Its voltage table (938 mV at 25 C, 375 mV at 57 C) is a 100k NTC on a
100k pull-up to 1.875 V, which the generic 100K_PU scaling already
covers. Enable the ADC, describe the three channels as on aston and
export them through iio-hwmon; they guard the connector before any
SUPERVOOC work.

Verified on salami (7.3.0-salami060 with QCOM_SPMI_ADC5_GEN3=m and
SENSORS_IIO_HWMON=m): cold readings 25.4/25.4/25.5 C against a 26.0 C
battery; holding a finger on the port raised both USB channels by
about 1.8 C and the subboard by 0.8 C while the battery stayed flat.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/sm8550-oneplus-salami.dts   | 50 ++++++++++++++++++-
 1 file changed, 49 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts b/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
index 2cf2d660e..bb6fd8e04 100644
--- a/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
+++ b/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
@@ -468,4 +468,52 @@ &remoteproc_mpss {
 			"qcom/sm8550/oneplus/salami/modem_dtb.mdt";
 	status = "okay";
 };
-&pmk8550_vadc { status = "disabled"; };
+
+/*
+ * Stock oplus,battery usb_temp_adc / usb_supplementary_temp_adc /
+ * subboard_temp_adc: 100k NTCs on PM8550B, read ratiometric with the 1.875 V
+ * pull-up (stock con_volt_855 table: 938 mV at 25 C), so the generic 100k_PU
+ * scaling applies. Stock pins: gpio5 (left), gpio10 (right), gpio6 (subboard).
+ */
+&pm8550b_gpios {
+	usb_therm_default: usb-therm-state {
+		pins = "gpio5", "gpio6", "gpio10";
+		function = "normal";
+		bias-high-impedance;
+	};
+};
+
+&pmk8550_vadc {
+	pinctrl-0 = <&usb_therm_default>;
+	pinctrl-names = "default";
+
+	channel@749 {
+		reg = <ADC5_GEN3_AMUX6_THM_100K_PU(7)>;
+		label = "usb_r_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	channel@74b {
+		reg = <ADC5_GEN3_AMUX2_GPIO_100K_PU(7)>;
+		label = "usb_l_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	channel@74c {
+		reg = <ADC5_GEN3_AMUX3_GPIO_100K_PU(7)>;
+		label = "subboard_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+};
+
+/ {
+	iio-hwmon {
+		compatible = "iio-hwmon";
+		io-channels = <&pmk8550_vadc ADC5_GEN3_AMUX2_GPIO_100K_PU(7)>,
+			      <&pmk8550_vadc ADC5_GEN3_AMUX6_THM_100K_PU(7)>,
+			      <&pmk8550_vadc ADC5_GEN3_AMUX3_GPIO_100K_PU(7)>;
+	};
+};
