+// SPDX-License-Identifier: GPL-2.0-only
+
+
+&apps_rsc {
+	regulators-0 {
+		vreg_l12b: ldo12 {
+			regulator-name = "salami-l12b";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+		vreg_l13b: ldo13 {
+			regulator-name = "salami-l13b";
+			regulator-min-microvolt = <3200000>;
+			regulator-max-microvolt = <3200000>;
+		};
+	};
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	status = "okay";
+	vdda-supply = <&vreg_l3e>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&salami_panel_reset &salami_panel_te>;
+
+	salami_panel: panel@0 {
+		compatible = "samsung,amb670yf07-cs";
+		reg = <0>;
+		vddio-supply = <&vreg_l12b>;
+		vci-supply = <&vreg_l13b>;
+		reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;
+		vout-gpios = <&tlmm 90 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+
+		port {
+			salami_panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&salami_panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l1e>;
+	status = "okay";
+};
+
+/* Iris secondary input is not a second physical panel. */
+&mdss_dsi1 {
+	status = "disabled";
+};
+
+&mdss_dsi1_phy {
+	status = "disabled";
+};
+
+&tlmm {
+	salami_panel_reset: salami-panel-reset-state {
+		pins = "gpio133";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	salami_panel_te: salami-panel-te-state {
+		pins = "gpio86";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+&salami_panel {
+	/* Iris and panel vddio independently vote the shared L12B rail. */
+	clocks = <&rpmhcc RPMH_DIV_CLK1>;
+	clock-names = "iris";
+	iris-v18-supply = <&vreg_l12b>;
+	iris-v09-enable-gpios = <&tlmm 105 GPIO_ACTIVE_HIGH>;
+	iris-vdd-enable-gpios = <&tlmm 92 GPIO_ACTIVE_HIGH>;
+	iris-reset-gpios = <&tlmm 109 GPIO_ACTIVE_LOW>;
+	iris-wakeup-gpios = <&tlmm 129 GPIO_ACTIVE_HIGH>;
+	iris-abyp-ready-gpios = <&tlmm 181 GPIO_ACTIVE_HIGH>;
+	vsync-mux-gpios = <&tlmm 57 GPIO_ACTIVE_HIGH>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&salami_iris_controls &salami_iris_clk>;
+};
+
+&tlmm {
+	salami_iris_controls: salami-iris-controls-state {
+		pins = "gpio109", "gpio129", "gpio181";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+};
+
+&pmk8550_gpios {
+	salami_iris_clk: iris-clk-state {
+		pins = "gpio5";
+		function = "func2";
+		input-disable;
+		output-enable;
+		bias-disable;
+		power-source = <0>;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami-touch.dtsi b/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami-touch.dtsi
new file mode 100644
index 000000000..8a4897058
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami-touch.dtsi
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* OnePlus 11 S3908; native coordinates are read from APP_INFO. */
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	vreg_touch_avdd: regulator-touch-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "touch-avdd-enable";
+		gpio = <&tlmm 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		/* Stock drives GPIO10 high. External rail voltage is not measured. */
+	};
+};
+
+&apps_rsc {
+	regulators-0 {
+		vreg_l4b: ldo4 {
+			regulator-name = "salami-l4b";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+	};
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
+&i2c4 {
+	status = "okay";
+	/* The controller defaults to 100 kHz; stock FDT has no clock-frequency. */
+	salami_touch: touchscreen@4b {
+		compatible = "syna,s3908";
+		reg = <0x4b>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <25 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&vreg_l4b>;
+		avdd-supply = <&vreg_touch_avdd>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&salami_touch_irq &salami_touch_reset>;
+	};
+};
+
+&tlmm {
+	salami_touch_irq: salami-touch-irq-state {
+		pins = "gpio25";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+		input-enable;
+	};
+
+	salami_touch_reset: salami-touch-reset-state {
+		pins = "gpio24";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts b/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
new file mode 100644
index 000000000..2cf2d660e
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
@@ -0,0 +1,471 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * OnePlus 11 (salami, project 22811).
+ * Sources: stock-2026-11-06/fdt.dtb (883468 bytes);
+ * Perpetua f2941a66b02ad4e71ca2b219368bac57c8bf8c50 bindings.
+ */
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include "sm8550.dtsi"
+#include "pm8550b.dtsi"
+#include "pmk8550.dtsi"
+
+/ {
+	model = "OnePlus 11 (salami)";
+	compatible = "oneplus,salami", "qcom,sm8550";
+	chassis-type = "handset";
+	aliases {
+		serial0 = &uart14;
+	};
+	/* Empty sentinel: ARM64_FDT_HANDOFF replaces reg with bootloader RAM. */
+	memory@a0000000 { reg = <0 0 0 0>; };
+	chosen {
+		bootargs = "rdinit=/init loglevel=7 panic=10 oops=panic msm.separate_gpu_kms=1";
+		fdt-handoff {
+			/* All three conditions are required by the existing schema. */
+			stock-compatible = "qcom,kalama-mtp";
+			stock-model = "Qualcomm Technologies, Inc. Kalama MTP,salami";
+			/* Observed /chosen/bootargs word, not a root property. */
+			stock-bootargs = "oplusboot.prjname=22811";
+			/* No keep-initrd: use the built-in BusyBox initramfs. */
+		};
+	};
+
+	reserved-memory {
+		/*
+		 * Kernel log across a reset, as on aston. RAM outside every stock
+		 * reservation. Write-combine (mem-type 0): a cached mapping would
+		 * lose the log in the CPU caches.
+		 */
+		ramoops@e2000000 {
+			compatible = "ramoops";
+			reg = <0 0xe2000000 0 0x200000>;
+			console-size = <0x200000>;
+			mem-type = <0>;
+		};
+	};
+
+	/*
+	 * Battery and charger live in the ADSP (stock qcom,pmic-glink with
+	 * oplus,adsp-voocphy, no AP-side charger or gauge). Stock describes
+	 * the single USB 2.0 port as dual-role; UCSI supplies its role events.
+	 */
+	pmic-glink {
+		compatible = "oneplus,sm8550-pmic-glink", "qcom,sm8550-pmic-glink",
+			     "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_1_dwc3_hs>;
+					};
+				};
+			};
+		};
+	};
+
+	/* Stock cnss chip_cfg@1 (WCN7850, 0x1107): wlan-en 80, bt-en 81, sw-ctrl 82. */
+	wcn7850-pmu {
+		compatible = "qcom,wcn7850-pmu";
+		pinctrl-0 = <&wlan_en>, <&bt_default>, <&pmk8550_sleep_clk>;
+		pinctrl-names = "default";
+		wlan-enable-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
+		/* Stock qcom,pmu_vreg_map. */
+		vdd-supply = <&vreg_s5g>;
+		vddio-supply = <&vreg_l15b>;
+		vddaon-supply = <&vreg_s2g>;
+		vdddig-supply = <&vreg_s4e>;
+		vddrfa1p2-supply = <&vreg_s4g>;
+		vddrfa1p8-supply = <&vreg_s6g>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 { regulator-name = "vreg_pmu_rfa_cmn"; };
+			vreg_pmu_aon_0p59: ldo1 { regulator-name = "vreg_pmu_aon_0p59"; };
+			vreg_pmu_wlcx_0p8: ldo2 { regulator-name = "vreg_pmu_wlcx_0p8"; };
+			vreg_pmu_wlmx_0p85: ldo3 { regulator-name = "vreg_pmu_wlmx_0p85"; };
+			vreg_pmu_btcmx_0p85: ldo4 { regulator-name = "vreg_pmu_btcmx_0p85"; };
+			vreg_pmu_rfa_0p8: ldo5 { regulator-name = "vreg_pmu_rfa_0p8"; };
+			vreg_pmu_rfa_1p2: ldo6 { regulator-name = "vreg_pmu_rfa_1p2"; };
+			vreg_pmu_rfa_1p8: ldo7 { regulator-name = "vreg_pmu_rfa_1p8"; };
+			vreg_pmu_pcie_0p9: ldo8 { regulator-name = "vreg_pmu_pcie_0p9"; };
+			vreg_pmu_pcie_1p8: ldo9 { regulator-name = "vreg_pmu_pcie_1p8"; };
+		};
+	};
+};
+
+/* Values from this device's fixed-clock nodes. */
+&xo_board { clock-frequency = <76800000>; };
+&sleep_clk { clock-frequency = <32000>; };
+
+/*
+ * Disable inherited example reservations; the handoff imports ALL fixed stock
+ * reservations and subtracts stock no-map regions. Keep label targets for
+ * disabled SoC devices; regions that enabled devices reference stay enabled.
+ */
+&aop_cmd_db_mem { reg = <0 0x81c60000 0 0x20000>; };
+&smem { reg = <0 0x81d00000 0 0x200000>; };
+&hyp_mem { status = "disabled"; };
+&cpusys_vm_mem { status = "disabled"; };
+&hyp_tags_mem { status = "disabled"; };
+&xbl_sc_mem { status = "disabled"; };
+&hyp_tags_reserved_mem { status = "disabled"; };
+&xbl_dt_log_merged_mem { status = "disabled"; };
+&aop_config_merged_mem { status = "disabled"; };
+&adsp_mhi_mem { status = "disabled"; };
+&global_sync_mem { status = "disabled"; };
+&tz_stat_mem { status = "disabled"; };
+&cdsp_secure_heap_mem { status = "disabled"; };
+/* mpss/ipa/adsp/rmtfs regions below stay enabled: the remoteprocs and IPA reference them. */
+&ipa_gsi_mem { status = "disabled"; };
+/* Stock GPU zap carveout; the signed shader is copied from this device's vendor. */
+&gpu_micro_code_mem { reg = <0 0x9b09a000 0 0x2000>; };
+&spss_region_mem { status = "disabled"; };
+&spu_tz_shared_mem { status = "disabled"; };
+&spu_modem_shared_mem { status = "disabled"; };
+&camera_mem { status = "disabled"; };
+&video_mem { status = "disabled"; };
+&cvp_mem { status = "disabled"; };
+&cdsp_mem { status = "disabled"; };
+&q6_cdsp_dtb_mem { status = "disabled"; };
+/* Stock adspslpi region is 0x4880000, larger than the dtsi's. */
+&adspslpi_mem { reg = <0 0x9ea00000 0 0x4880000>; };
+&tz_reserved_mem { status = "disabled"; };
+&cpucp_fw_mem { status = "disabled"; };
+&qtee_mem { status = "disabled"; };
+&ta_mem { status = "disabled"; };
+&tz_tags_mem { status = "disabled"; };
+&hwfence_shbuf { status = "disabled"; };
+&trust_ui_vm_mem { status = "disabled"; };
+&trust_ui_vm_dump { status = "disabled"; };
+&trust_ui_vm_qrtr { status = "disabled"; };
+&trust_ui_vm_vblk0_ring { status = "disabled"; };
+&trust_ui_vm_vblk1_ring { status = "disabled"; };
+&trust_ui_vm_swiotlb { status = "disabled"; };
+&oem_vm_mem { status = "disabled"; };
+&oem_vm_vblk0_ring { status = "disabled"; };
+&oem_vm_swiotlb { status = "disabled"; };
+&hyp_ext_tags_mem { status = "disabled"; };
+&hyp_ext_reserved_mem { status = "disabled"; };
+
+/*
+ * Stock RPMh resources: ldob5/15/17, ldod1, ldoe1/3, ldog1/3, smpe4, smpg2/4/5/6.
+ * Target qcom-rpmh-regulator.c maps LDO number + pmic-id to these names.
+ * No unverified parent-supply wiring is added.
+ */
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm8550-rpmh-regulators";
+		qcom,pmic-id = "b";
+		vreg_l5b: ldo5 {
+			regulator-name = "salami-l5b";
+			regulator-min-microvolt = <3104000>;
+			regulator-max-microvolt = <3104000>;
+		};
+		vreg_l15b: ldo15 {
+			regulator-name = "salami-l15b";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+		vreg_l17b: ldo17 {
+			regulator-name = "salami-l17b";
+			regulator-min-microvolt = <2504000>;
+			regulator-max-microvolt = <2504000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+	regulators-1 {
+		compatible = "qcom,pm8550vs-rpmh-regulators";
+		qcom,pmic-id = "d";
+		vreg_l1d: ldo1 {
+			regulator-name = "salami-l1d";
+			regulator-min-microvolt = <880000>;
