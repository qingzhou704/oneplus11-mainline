+/* Hardent DSC 1.2 pipeline latency, from Qualcomm's sde_encoder_dce.c. */
+static u32 dpu_encoder_dsc_initial_line_calc_1_2(struct drm_dsc_config *dsc,
+					       u32 enc_ip_width, u32 mode)
+{
+	u32 soft_slices = enc_ip_width / dsc->slice_width;
+	u32 container_width = dsc->native_422 ? dsc->slice_width / 2 : dsc->slice_width;
+	u32 mux_word_size = dsc->bits_per_component >= 12 ? 64 : 48;
+	u32 output_width = dsc->native_420 || dsc->native_422 ? 128 : 64;
+	u32 bpp_group = dsc->bits_per_pixel * (dsc->native_422 ? 2 : 1);
+	u32 max_ssm_delay = 4 * (10 + 1) + 48 - 1;
+	u32 input_latency = 28 + 3 * (max_ssm_delay + 2) * soft_slices;
+	u32 output_latency, extra_bits, extra_latency, chunk_bits;
+
+	/* bits_per_pixel is Q4; keep the fractional bits in the latency math. */
+	output_latency = DIV_ROUND_UP((9 * output_width + mux_word_size) * 16,
+				    bpp_group) + 1;
+	chunk_bits = 8 * dsc->slice_chunk_size;
+	if (((mode & DSC_MODE_SPLIT_PANEL) && (mode & DSC_MODE_MULTIPLEX)) ||
+	    (soft_slices > 1 && output_width * 16 > bpp_group))
+		extra_bits = chunk_bits;
+	else
+		extra_bits = (output_width * 16 - bpp_group) * chunk_bits /
+			     (output_width * 16);
+	extra_latency = DIV_ROUND_UP(extra_bits * 16, bpp_group);
+
+	return DIV_ROUND_UP(dsc->initial_xmit_delay + input_latency +
+			    output_latency + extra_latency, container_width);
+}
