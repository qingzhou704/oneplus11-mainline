+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung AMB670YF07_CS on OnePlus 11 (salami), fixed WQHD 60 Hz.
+ * Register sequences: Copyright (C) 2022 OPLUS Mobile Comm Corp., Ltd.
+ *
+ * Offline bring-up candidate. The upstream DSI host must preserve the complete
+ * DSC configuration below. Iris 7 must signal analog bypass after controlled
+ * reset before the panel reset sequence or any initialization command is sent.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#include "iris7-bypass.h"
+
+struct amb670yf07 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator_bulk_data supplies[2];
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *vout_gpio;
+	struct gpio_desc *vsync_mux_gpio;
+	struct iris7_bypass *iris;
+};
+
+struct amb670yf07_cmd {
+	u8 type;
+	u8 delay_ms;
+	size_t len;
+	const u8 *data;
+};
+
+#define AMB_CMD(dtype, wait, ...) { \
+	.type = dtype, .delay_ms = wait, \
+	.len = sizeof((const u8[]){ __VA_ARGS__ }), \
+	.data = (const u8[]){ __VA_ARGS__ }, \
+}
+
+#include "panel-samsung-amb670yf07-data.h"
+
+static struct amb670yf07 *to_amb670yf07(struct drm_panel *panel)
+{
+	return container_of(panel, struct amb670yf07, panel);
+}
+
+static int amb670yf07_init(struct amb670yf07 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	unsigned int i;
+	ssize_t ret;
+
+	for (i = 0; i < ARRAY_SIZE(amb670yf07_on); i++) {
+		const struct amb670yf07_cmd *cmd = &amb670yf07_on[i];
+		struct mipi_dsi_msg msg = {
+			.channel = dsi->channel,
+			.type = cmd->type,
+			.flags = MIPI_DSI_MSG_USE_LPM,
+			.tx_len = cmd->len,
+			.tx_buf = cmd->data,
+		};
+
+		/* Preserve even the vendor's two-byte long packets. 0x40 in the
+		 * downstream header means batching, not a panel payload byte.
+		 * Mainline submits each packet synchronously instead.
+		 */
+		ret = dsi->host->ops->transfer(dsi->host, &msg);
+		if (ret < 0)
+			return dev_err_probe(&dsi->dev, ret,
+					     "initialization packet %u failed\n", i);
+		/* msm returns the padded DMA packet size, including its header. */
+		if (cmd->delay_ms)
+			fsleep(cmd->delay_ms * 1000);
+	}
+
+	dev_info(&dsi->dev, "WQHD60 initialization complete\n");
+	return 0;
+}
+
+static int amb670yf07_power_off(struct amb670yf07 *ctx)
+{
+	int ret, err;
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	gpiod_set_value_cansleep(ctx->vout_gpio, 0);
+	ret = iris7_bypass_power_off(ctx->iris);
+	if (ret)
+		dev_err(&ctx->dsi->dev, "failed to power off Iris: %d\n", ret);
+	err = regulator_disable(ctx->supplies[1].consumer);
+	if (err) {
+		dev_err(&ctx->dsi->dev, "failed to disable vci: %d\n", err);
+		if (!ret)
+			ret = err;
+	}
+	/* Stock vddio pre-off delay, after vci has been disabled. */
+	usleep_range(10000, 10100);
+	err = regulator_disable(ctx->supplies[0].consumer);
+	if (err)
+		dev_err(&ctx->dsi->dev, "failed to disable vddio: %d\n", err);
+	return ret ? ret : err;
+}
+
+static int amb670yf07_prepare(struct drm_panel *panel)
+{
+	struct amb670yf07 *ctx = to_amb670yf07(panel);
+	int ret, err;
+
+	/* Stock order: Iris rails, panel rails/vout, Iris reset, panel reset. */
+	ret = iris7_bypass_power_on(ctx->iris);
+	if (ret)
+		return dev_err_probe(&ctx->dsi->dev, ret, "Iris power-on failed\n");
+	ret = regulator_enable(ctx->supplies[0].consumer);
+	if (ret)
+		goto iris_off;
+	ret = regulator_enable(ctx->supplies[1].consumer);
+	if (ret) {
+		err = regulator_disable(ctx->supplies[0].consumer);
+		if (err)
+			dev_err(&ctx->dsi->dev, "failed to disable vddio: %d\n", err);
+		goto iris_off;
+	}
+
+	gpiod_set_value_cansleep(ctx->vout_gpio, 1);
+	ret = iris7_bypass_reset_and_wait(ctx->iris);
+	if (ret)
+		goto power_off;
+	/* WQHD60 is STANDARD_MFR: factory selects TP/TSP vsync, GPIO57=0. */
+	ret = gpiod_direction_output(ctx->vsync_mux_gpio, 0);
+	if (ret)
+		goto power_off;
+	dev_info(&ctx->dsi->dev, "vsync source: TP/TSP\n");
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 10100);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(5000, 5100);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 10100);
+	/* qcom,mdss-dsi-lp11-init / qcom,mdss-dsi-init-delay-us. */
+	usleep_range(1000, 1100);
+
+	ret = amb670yf07_init(ctx);
+	if (!ret)
+		return 0;
+power_off:
+	err = amb670yf07_power_off(ctx);
+	if (err)
+		dev_err(&ctx->dsi->dev, "power-off after failed prepare: %d\n", err);
+	return ret;
+iris_off:
+	err = iris7_bypass_power_off(ctx->iris);
+	if (err)
+		dev_err(&ctx->dsi->dev, "Iris rollback failed: %d\n", err);
+	return ret;
+}
+
+static int amb670yf07_enable(struct drm_panel *panel)
+{
+	struct amb670yf07 *ctx = to_amb670yf07(panel);
+	int ret;
+
+	/* DRM bridge callbacks are void, so failed prepare must also gate enable. */
+	if (!panel->prepared)
+		return -EIO;
+	/* Stock WQHD60 emits 0x29 separately as post-on-backlight. */
+	ret = mipi_dsi_dcs_set_display_on(ctx->dsi);
+	if (ret)
+		return dev_err_probe(&ctx->dsi->dev, ret, "display-on command failed\n");
+	dev_info(&ctx->dsi->dev, "display-on command sent\n");
+	return 0;
+}
+
+static int amb670yf07_disable(struct drm_panel *panel)
+{
+	struct amb670yf07 *ctx = to_amb670yf07(panel);
+	int ret;
+
+	ret = mipi_dsi_dcs_set_display_off(ctx->dsi);
+	msleep(21);
+	return ret;
+}
+
+static int amb670yf07_unprepare(struct drm_panel *panel)
+{
+	struct amb670yf07 *ctx = to_amb670yf07(panel);
+	int ret, err;
+
+	ret = mipi_dsi_dcs_enter_sleep_mode(ctx->dsi);
+	msleep(101);
+	/* Stock dsi_panel_power_off waits another 2 ms before the GPIOs. */
+	usleep_range(2000, 2100);
+	err = amb670yf07_power_off(ctx);
+	if (err)
+		dev_err(&ctx->dsi->dev, "power-off failed: %d\n", err);
+	return ret ? ret : err;
+}
+
+static const struct drm_display_mode amb670yf07_mode = {
+	.clock = (1440 + 88 + 8 + 56) * (3216 + 8 + 8 + 8) * 60 / 1000,
+	.hdisplay = 1440,
+	.hsync_start = 1440 + 88,
+	.hsync_end = 1440 + 88 + 8,
+	.htotal = 1440 + 88 + 8 + 56,
+	.vdisplay = 3216,
+	.vsync_start = 3216 + 8,
+	.vsync_end = 3216 + 8 + 8,
+	.vtotal = 3216 + 8 + 8 + 8,
+	.width_mm = 70,
+	.height_mm = 156,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int amb670yf07_get_modes(struct drm_panel *panel,
+			       struct drm_connector *connector)
+{
+	connector->display_info.bpc = 10;
+	return drm_connector_helper_get_modes_fixed(connector, &amb670yf07_mode);
+}
+
+static const struct drm_panel_funcs amb670yf07_panel_funcs = {
+	.prepare = amb670yf07_prepare,
+	.enable = amb670yf07_enable,
+	.disable = amb670yf07_disable,
+	.unprepare = amb670yf07_unprepare,
+	.get_modes = amb670yf07_get_modes,
+};
+
+static int amb670yf07_bl_update(struct backlight_device *bl)
+{
+	struct amb670yf07 *ctx = bl_get_data(bl);
+	int ret;
+
+	if (!ctx->panel.prepared)
+		return 0;
+	ret = mipi_dsi_dcs_set_display_brightness_large(ctx->dsi,
+						     backlight_get_brightness(bl));
+	if (ret < 0)
+		return dev_err_probe(&ctx->dsi->dev, ret, "brightness command failed\n");
+	dev_info(&ctx->dsi->dev, "brightness command sent: %u\n",
+		 backlight_get_brightness(bl));
+	return 0;
+}
+
+static const struct backlight_ops amb670yf07_bl_ops = {
+	.update_status = amb670yf07_bl_update,
+};
+
+static int amb670yf07_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 1433,
+		.max_brightness = 2047, /* Stock normal range; HBM is not implemented. */
+	};
+	struct amb670yf07 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct amb670yf07, panel,
+				   &amb670yf07_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+	ctx->dsi = dsi;
+	ctx->iris = devm_iris7_bypass_get(dev);
+	if (IS_ERR(ctx->iris))
+		return dev_err_probe(dev, PTR_ERR(ctx->iris), "failed to acquire Iris resources\n");
+	ctx->dsc = amb670yf07_dsc;
+	ctx->supplies[0].supply = "vddio";
+	ctx->supplies[1].supply = "vci";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+	ret = regulator_set_load(ctx->supplies[0].consumer, 200000);
+	if (ret)
+		return ret;
+	ret = regulator_set_load(ctx->supplies[1].consumer, 10000);
+	if (ret)
+		return ret;
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "failed to get reset\n");
+	ctx->vout_gpio = devm_gpiod_get(dev, "vout", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->vout_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vout_gpio), "failed to get vout\n");
+	ctx->vsync_mux_gpio = devm_gpiod_get(dev, "vsync-mux", GPIOD_ASIS);
+	if (IS_ERR(ctx->vsync_mux_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vsync_mux_gpio), "failed to get vsync mux\n");
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT;
+	dsi->hs_rate = 1363200000;
+	dsi->dsc = &ctx->dsc;
+	dsi->dsc_params_provided = true;
+	ctx->panel.prepare_prev_first = true;
+	mipi_dsi_set_drvdata(dsi, ctx);
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev),
+						dev, ctx, &amb670yf07_bl_ops, &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight), "failed to create backlight\n");
+	drm_panel_add(&ctx->panel);
+	ret = devm_mipi_dsi_attach(dev, dsi);
+	if (ret)
+		drm_panel_remove(&ctx->panel);
+	return ret;
+}
+
+static void amb670yf07_remove(struct mipi_dsi_device *dsi)
+{
+	struct amb670yf07 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_disable(&ctx->panel);
+	drm_panel_unprepare(&ctx->panel);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id amb670yf07_of_match[] = {
+	{ .compatible = "samsung,amb670yf07-cs" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, amb670yf07_of_match);
+
+static struct mipi_dsi_driver amb670yf07_driver = {
+	.probe = amb670yf07_probe,
+	.remove = amb670yf07_remove,
+	.driver = {
+		.name = "panel-samsung-amb670yf07",
+		.of_match_table = amb670yf07_of_match,
+	},
+};
+module_mipi_dsi_driver(amb670yf07_driver);
+
+MODULE_DESCRIPTION("Samsung AMB670YF07_CS WQHD60 panel (salami bring-up)");
+MODULE_LICENSE("GPL");
