diff --git a/drivers/input/touchscreen/synaptics_tcm_i2c.c b/drivers/input/touchscreen/synaptics_tcm_i2c.c
new file mode 100644
index 000000000..9855f83d1
--- /dev/null
+++ b/drivers/input/touchscreen/synaptics_tcm_i2c.c
@@ -0,0 +1,702 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Synaptics S3908 TouchComm generation-1 I2C touchscreen.
+ * Derived from Vsevolod Nevorotov's September 2026 I2C v2 submission.
+ * Transfer, report and power sequencing follow the OnePlus Syna_tcm_oncell
+ * driver. Only an application already resident in flash is supported.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+
+#define SYNA_MARKER			0xa5
+#define SYNA_PADDING			0x5a
+#define SYNA_HEADER_SIZE		4
+#define SYNA_MIN_READ_SIZE		9
+#define SYNA_MAX_PAYLOAD		1024
+#define SYNA_MAX_CONFIG		256
+#define SYNA_MAX_OBJECTS		16 /* Four-bit object index. */
+#define SYNA_RESPONSE_TIMEOUT_MS	1000
+#define SYNA_APP_TIMEOUT_MS		1000
+#define SYNA_APP_POLL_MS		100
+
+#define SYNA_CMD_CONTINUE_WRITE		0x01
+#define SYNA_CMD_IDENTIFY		0x02
+#define SYNA_CMD_ENABLE_REPORT		0x05
+#define SYNA_CMD_DISABLE_REPORT		0x06
+#define SYNA_CMD_GET_APP_INFO		0x20
+#define SYNA_CMD_GET_REPORT_CONFIG	0x25
+#define SYNA_CMD_SET_REPORT_CONFIG	0x26
+#define SYNA_CMD_ENTER_DEEP_SLEEP	0x2c
+#define SYNA_CMD_EXIT_DEEP_SLEEP		0x2d
+
+#define SYNA_STATUS_IDLE		0x00
+#define SYNA_STATUS_OK			0x01
+#define SYNA_STATUS_BUSY		0x02
+#define SYNA_STATUS_CONTINUED_READ	0x03
+#define SYNA_STATUS_INVALID		0xff
+#define SYNA_REPORT_IDENTIFY		0x10
+#define SYNA_REPORT_TOUCH		0x11
+#define SYNA_MODE_APPLICATION		0x01
+#define SYNA_APP_OK			0x00
+#define SYNA_APP_BOOTING			0x01
+#define SYNA_APP_UPDATING		0x02
+
+#define SYNA_OBJECT_FINGER		1
+#define SYNA_OBJECT_GLOVED_FINGER	2
+#define SYNA_REPORT_PREFIX_SIZE		7
+#define SYNA_OBJECT_SIZE		12
+
+enum syna_report_field {
+	SYNA_TOUCH_END = 0,
+	SYNA_TOUCH_FOREACH_ACTIVE = 1,
+	SYNA_TOUCH_FOREACH_END = 3,
+	SYNA_TOUCH_INDEX = 6,
+	SYNA_TOUCH_CLASS = 7,
+	SYNA_TOUCH_X = 8,
+	SYNA_TOUCH_Y = 9,
+	SYNA_TOUCH_X_WIDTH = 11,
+	SYNA_TOUCH_Y_WIDTH = 12,
+	SYNA_TOUCH_GESTURE = 16,
+	SYNA_TOUCH_GESTURE_INFO = 198,
+	SYNA_TOUCH_GRIP_INFO = 203,
+};
+
+/* Stock normal_config_version == 0; gesture/grip metadata is not input. */
+static const u8 syna_report_config[] = {
+	SYNA_TOUCH_GESTURE, 8,
+	SYNA_TOUCH_GESTURE_INFO, 48,
+	SYNA_TOUCH_FOREACH_ACTIVE,
+	SYNA_TOUCH_INDEX, 4,
+	SYNA_TOUCH_CLASS, 4,
+	SYNA_TOUCH_X, 16,
+	SYNA_TOUCH_Y, 16,
+	SYNA_TOUCH_X_WIDTH, 12,
+	SYNA_TOUCH_Y_WIDTH, 12,
+	SYNA_TOUCH_GRIP_INFO, 32,
+	SYNA_TOUCH_FOREACH_END,
+	SYNA_TOUCH_END,
+};
+
+struct syna_identification {
+	u8 version;
+	u8 mode;
+	u8 part_number[16];
+	__le32 build_id;
+	__le16 max_write_size;
+} __packed;
+
+struct syna_app_info {
+	__le16 version;
+	__le16 status;
+	__le16 static_config_size;
+	__le16 dynamic_config_size;
+	__le16 app_config_start_write_block;
+	__le16 app_config_size;
+	__le16 max_touch_report_config_size;
+	__le16 max_touch_report_payload_size;
+	u8 customer_config_id[16];
+	__le16 max_x;
+	__le16 max_y;
+	__le16 max_objects;
+	__le16 num_of_buttons;
+	__le16 num_of_image_rows;
+	__le16 num_of_image_cols;
+	__le16 has_hybrid_data;
+} __packed;
+
+struct syna_object {
+	bool active;
+	u16 x;
+	u16 y;
+	u16 wx;
+	u16 wy;
+};
+
+struct syna_tcm {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct touchscreen_properties prop;
+	struct gpio_desc *reset_gpio;
+	struct regulator *avdd;
+	struct regulator *vddi;
+	/* IRQ is disabled while probe/PM executes synchronous commands. */
+	struct mutex lock;
+	bool report_configured;
+	unsigned int read_length;
+	unsigned int read_limit;
+	unsigned int write_limit;
+	u8 xfer[SYNA_MAX_PAYLOAD + SYNA_HEADER_SIZE + 1];
+	u8 message[SYNA_MAX_PAYLOAD + SYNA_HEADER_SIZE + 1];
+	u8 command[SYNA_MAX_CONFIG + 2];
+	u8 config[SYNA_MAX_CONFIG];
+	u8 code;
+	unsigned int payload_length;
+	unsigned int config_size;
+	unsigned int max_x;
+	unsigned int max_y;
+	unsigned int max_objects;
+	struct syna_object objects[SYNA_MAX_OBJECTS];
+};
+
+static int syna_recv_message(struct syna_tcm *ts)
+{
+	unsigned int total, offset, count;
+	int ret;
+
+	ret = i2c_master_recv(ts->client, ts->message, ts->read_length);
+	if (ret < 0)
+		return ret;
+	if (ret != ts->read_length)
+		return -EIO;
+	if (ts->message[0] != SYNA_MARKER)
+		return -EPROTO;
+
+	ts->code = ts->message[1];
+	ts->payload_length = get_unaligned_le16(&ts->message[2]);
+	dev_dbg(&ts->client->dev, "read=%u code=%02x payload=%u\n",
+		ts->read_length, ts->code, ts->payload_length);
+
+	/* Idle/busy length bytes are not meaningful. */
+	if (ts->code == SYNA_STATUS_IDLE || ts->code == SYNA_STATUS_BUSY) {
+		ts->payload_length = 0;
+		return 0;
+	}
+	if (ts->code == SYNA_STATUS_CONTINUED_READ ||
+	    ts->code == SYNA_STATUS_INVALID)
+		return -EPROTO;
+	if (ts->payload_length > SYNA_MAX_PAYLOAD)
+		return -EMSGSIZE;
+
+	total = SYNA_HEADER_SIZE + ts->payload_length + 1;
+	offset = ts->read_length;
+	while (offset < total) {
+		/* Stock TCM does not fetch a lone trailing padding byte. */
+		if (total - offset == 1) {
+			ts->message[offset] = SYNA_PADDING;
+			break;
+		}
+		count = min(total - offset, ts->read_limit - 2);
+		ret = i2c_master_recv(ts->client, ts->xfer, count + 2);
+		if (ret < 0)
+			return ret;
+		if (ret != count + 2)
+			return -EIO;
+		if (ts->xfer[0] != SYNA_MARKER ||
+		    ts->xfer[1] != SYNA_STATUS_CONTINUED_READ)
+			return -EPROTO;
+		memcpy(&ts->message[offset], &ts->xfer[2], count);
+		offset += count;
+	}
+	if (ts->message[total - 1] != SYNA_PADDING)
+		return -EPROTO;
+
+	ts->read_length = min(max(total, SYNA_MIN_READ_SIZE), ts->read_limit);
+	return 0;
+}
+
+static int syna_write_command(struct syna_tcm *ts, u8 cmd,
+			      const u8 *payload, unsigned int length)
+{
+	unsigned int offset = 0, count;
+	int ret;
+
+	put_unaligned_le16(length, ts->command);
+	if (length)
+		memcpy(&ts->command[2], payload, length);
+	while (offset < length + 2) {
+		count = min(length + 2 - offset, ts->write_limit - 1);
+		ts->xfer[0] = offset ? SYNA_CMD_CONTINUE_WRITE : cmd;
+		memcpy(&ts->xfer[1], &ts->command[offset], count);
+		ret = i2c_master_send(ts->client, ts->xfer, count + 1);
+		if (ret < 0)
+			return ret;
+		if (ret != count + 1)
+			return -EIO;
+		offset += count;
+	}
+	return 0;
+}
+
+/* IRQ is not running here; reports may precede a command response. */
+static int syna_exec_command(struct syna_tcm *ts, u8 cmd,
+			     const u8 *payload, unsigned int length)
+{
+	unsigned long deadline;
+	int ret;
+
+	ret = syna_write_command(ts, cmd, payload, length);
+	if (ret)
+		goto error;
+
+	deadline = jiffies + msecs_to_jiffies(SYNA_RESPONSE_TIMEOUT_MS);
+	do {
+		usleep_range(5000, 6000);
+		ret = syna_recv_message(ts);
+		if (ret)
+			goto error;
+		if (ts->code == SYNA_STATUS_OK)
+			return 0;
+		if (ts->code == SYNA_REPORT_IDENTIFY) {
+			/* Do not mistake the boot report for IDENTIFY's OK reply. */
+			if (cmd == SYNA_CMD_IDENTIFY)
+				continue;
+			ret = -ECONNRESET;
+			goto error;
+		}
+		if (ts->code == SYNA_STATUS_IDLE || ts->code == SYNA_STATUS_BUSY ||
+		    ts->code >= SYNA_REPORT_IDENTIFY)
+			continue;
+		dev_err(&ts->client->dev, "command %02x status=%02x\n", cmd, ts->code);
+		ret = -EIO;
+		goto error;
+	} while (time_before(jiffies, deadline));
+	ret = -ETIMEDOUT;
+error:
+	dev_err(&ts->client->dev, "command %02x failed: %d\n", cmd, ret);
+	return ret;
+}
+
+static int syna_identify(struct syna_tcm *ts)
+{
+	const struct syna_identification *id;
+	unsigned long deadline = jiffies + msecs_to_jiffies(SYNA_RESPONSE_TIMEOUT_MS);
+	unsigned int limit;
+	int ret;
+
+	/* Reset produces IDENTIFY asynchronously. Drain it before any command:
+	 * this controller drops commands sent while its boot report is pending.
+	 */
+	for (;;) {
+		ret = syna_recv_message(ts);
+		if (ret)
+			return ret;
+		if (ts->code == SYNA_REPORT_IDENTIFY)
+			break;
+		if (time_after_eq(jiffies, deadline))
+			return -ETIMEDOUT;
+		usleep_range(5000, 6000);
+	}
+	if (ts->payload_length < sizeof(*id))
+		return -EPROTO;
+	id = (const void *)&ts->message[SYNA_HEADER_SIZE];
+	dev_info(&ts->client->dev,
+		 "TouchComm v%u mode=%02x part=%.16s build=%u max_write=%u\n",
+		 id->version, id->mode, id->part_number,
+		 le32_to_cpu(id->build_id), le16_to_cpu(id->max_write_size));
+	if (id->version != 1 || id->mode != SYNA_MODE_APPLICATION)
+		return -ENODEV;
+	limit = le16_to_cpu(id->max_write_size);
+	if (limit) {
+		if (limit < 3)
+			return -EPROTO;
+		ts->write_limit = min(ts->write_limit, limit);
+	}
+	return 0;
+}
+
+static int syna_get_app_info(struct syna_tcm *ts, struct syna_app_info *info)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(SYNA_APP_TIMEOUT_MS);
+	unsigned int status;
+	int ret;
+
+	for (;;) {
+		ret = syna_exec_command(ts, SYNA_CMD_GET_APP_INFO, NULL, 0);
+		if (ret)
+			return ret;
+		if (ts->payload_length < sizeof(*info))
+			return -EPROTO;
+		memcpy(info, &ts->message[SYNA_HEADER_SIZE], sizeof(*info));
+		status = le16_to_cpu(info->status);
+		if (status == SYNA_APP_OK)
+			return 0;
+		if (status != SYNA_APP_BOOTING) {
+			dev_err(&ts->client->dev, "APP_INFO status=%04x\n", status);
+			return status == SYNA_APP_UPDATING ? -EBUSY : -EIO;
+		}
+		if (time_after_eq(jiffies, deadline)) {
+			dev_err(&ts->client->dev, "APP_INFO still booting\n");
+			return -ETIMEDOUT;
+		}
+		msleep(SYNA_APP_POLL_MS);
+	}
+}
+
+static int syna_check_app_info(struct syna_tcm *ts,
+			       const struct syna_app_info *info)
+{
+	unsigned int objects = le16_to_cpu(info->max_objects);
+	unsigned int config = le16_to_cpu(info->max_touch_report_config_size);
+	unsigned int payload = le16_to_cpu(info->max_touch_report_payload_size);
+
+	if (!le16_to_cpu(info->max_x) || !le16_to_cpu(info->max_y) ||
+	    !objects || objects > SYNA_MAX_OBJECTS ||
+	    config < sizeof(syna_report_config) || config > SYNA_MAX_CONFIG ||
+	    payload < SYNA_REPORT_PREFIX_SIZE + objects * SYNA_OBJECT_SIZE) {
+		dev_err(&ts->client->dev,
+			"unsupported APP_INFO max_x=%u max_y=%u objects=%u config=%u payload=%u\n",
+			le16_to_cpu(info->max_x), le16_to_cpu(info->max_y),
+			objects, config, payload);
+		return -EPROTO;
+	}
+	return 0;
+}
+
+static int syna_configure_reports(struct syna_tcm *ts)
+{
+	const u8 *config;
+	u8 report = SYNA_REPORT_TOUCH;
+	int ret;
+
+	ts->report_configured = false;
+	ret = syna_exec_command(ts, SYNA_CMD_DISABLE_REPORT, &report, 1);
+	if (ret)
+		return ret;
+	/* Vendor writes max_touch_report_config_size, zero-padded after END. */
+	memset(ts->config, 0, ts->config_size);
+	memcpy(ts->config, syna_report_config, sizeof(syna_report_config));
+	ret = syna_exec_command(ts, SYNA_CMD_SET_REPORT_CONFIG,
+				ts->config, ts->config_size);
+	if (ret)
+		return ret;
+	ret = syna_exec_command(ts, SYNA_CMD_GET_REPORT_CONFIG, NULL, 0);
+	if (ret)
+		return ret;
+	config = &ts->message[SYNA_HEADER_SIZE];
+	if (ts->payload_length < sizeof(syna_report_config) ||
+	    ts->payload_length > ts->config_size ||
+	    memcmp(config, syna_report_config, sizeof(syna_report_config))) {
+		dev_err(&ts->client->dev, "touch report config readback mismatch\n");
+		return -EPROTO;
+	}
+	ret = syna_exec_command(ts, SYNA_CMD_ENABLE_REPORT, &report, 1);
+	if (ret)
+		return ret;
+	ts->report_configured = true;
+	return 0;
+}
+
+static int syna_parse_report(struct syna_tcm *ts)
+{
+	unsigned int offset, index, classification, seen = 0;
+	struct syna_object *obj;
+	const u8 *data;
+	u32 width;
+
+	if (ts->payload_length < SYNA_REPORT_PREFIX_SIZE ||
+	    (ts->payload_length - SYNA_REPORT_PREFIX_SIZE) % SYNA_OBJECT_SIZE ||
+	    (ts->payload_length - SYNA_REPORT_PREFIX_SIZE) / SYNA_OBJECT_SIZE >
+	    ts->max_objects)
+		return -EPROTO;
+	memset(ts->objects, 0, sizeof(ts->objects));
+	for (offset = SYNA_REPORT_PREFIX_SIZE; offset < ts->payload_length;
+	     offset += SYNA_OBJECT_SIZE) {
+		data = &ts->message[SYNA_HEADER_SIZE + offset];
+		index = data[0] & 0x0f;
+		classification = data[0] >> 4;
+		if (index >= ts->max_objects || (seen & BIT(index)))
+			return -EPROTO;
+		seen |= BIT(index);
+		if (classification != SYNA_OBJECT_FINGER &&
+		    classification != SYNA_OBJECT_GLOVED_FINGER)
+			continue;
+		obj = &ts->objects[index];
+		obj->active = true;
+		obj->x = get_unaligned_le16(&data[1]);
+		obj->y = get_unaligned_le16(&data[3]);
+		if (obj->x > ts->max_x || obj->y > ts->max_y)
+			return -ERANGE;
+		width = data[5] | (data[6] << 8) | (data[7] << 16);
+		obj->wx = width & 0xfff;
+		obj->wy = width >> 12;
+	}
+	return 0;
+}
+
+static void syna_report_touch(struct syna_tcm *ts)
+{
+	unsigned int i;
+
+	for (i = 0; i < ts->max_objects; i++) {
+		const struct syna_object *obj = &ts->objects[i];
+
+		if (!obj->active)
+			continue;
+		input_mt_slot(ts->input, i);
+		input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, true);
+		touchscreen_report_pos(ts->input, &ts->prop, obj->x, obj->y, true);
+		input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, max(obj->wx, obj->wy));
+		input_report_abs(ts->input, ABS_MT_TOUCH_MINOR, min(obj->wx, obj->wy));
+	}
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+}
+
+static void syna_release_contacts(struct syna_tcm *ts)
+{
+	/* DROP_UNUSED releases every slot when this frame has no contacts. */
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+}
+
+static irqreturn_t syna_irq(int irq, void *data)
+{
+	struct syna_tcm *ts = data;
+	int ret;
+
+	mutex_lock(&ts->lock);
+	ret = syna_recv_message(ts);
+	if (ret)
+		goto error;
+	if (ts->code == SYNA_REPORT_IDENTIFY) {
+		ts->report_configured = false;
+		ret = -ECONNRESET;
+		goto error;
+	}
+	if (ts->code != SYNA_REPORT_TOUCH)
+		goto out;
+	if (!ts->report_configured) {
+		ret = -EPIPE;
+		goto error;
+	}
+	ret = syna_parse_report(ts);
+	if (ret)
+		goto error;
+	syna_report_touch(ts);
+	goto out;
+error:
+	dev_err_ratelimited(&ts->client->dev, "touch report failed: %d\n", ret);
+	syna_release_contacts(ts);
+out:
+	mutex_unlock(&ts->lock);
+	return IRQ_HANDLED;
+}
+
+static int syna_power_on(struct syna_tcm *ts)
+{
+	int ret, cleanup;
+
+	ret = regulator_enable(ts->avdd);
+	if (ret)
+		return ret;
+	ret = regulator_enable(ts->vddi);
+	if (ret) {
+		cleanup = regulator_disable(ts->avdd);
+		if (cleanup)
+			dev_err(&ts->client->dev, "AVDD rollback failed: %d\n", cleanup);
+		return ret;
+	}
+	/* reset-gpios is ACTIVE_LOW: logical 1 holds physical reset low. */
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ts->reset_gpio, 0);
+	msleep(80);
+	ts->read_length = SYNA_MIN_READ_SIZE;
+	return 0;
+}
+
+static void syna_power_off(void *data)
+{
+	struct syna_tcm *ts = data;
+	int ret;
+
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	ret = regulator_disable(ts->vddi);
+	if (ret) {
+		dev_err(&ts->client->dev, "VDDI disable failed: %d\n", ret);
+		return;
+	}
+	ret = regulator_disable(ts->avdd);
+	if (ret)
+		dev_err(&ts->client->dev, "AVDD disable failed: %d\n", ret);
+}
+
+static int syna_probe(struct i2c_client *client)
+{
+	const struct i2c_adapter_quirks *quirks = client->adapter->quirks;
+	struct device *dev = &client->dev;
+	struct syna_app_info info;
+	struct syna_tcm *ts;
+	int ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
+		return -EOPNOTSUPP;
+	if (client->irq <= 0)
+		return dev_err_probe(dev, -EINVAL, "missing interrupt\n");
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+	ts->client = client;
+	i2c_set_clientdata(client, ts);
+	ret = devm_mutex_init(dev, &ts->lock);
+	if (ret)
+		return ret;
+	ts->read_limit = sizeof(ts->xfer);
+	ts->write_limit = sizeof(ts->command) + 1;
+	if (quirks) {
+		if (quirks->max_read_len)
+			ts->read_limit = min_t(unsigned int, ts->read_limit,
+					       quirks->max_read_len);
+		if (quirks->max_write_len)
+			ts->write_limit = min_t(unsigned int, ts->write_limit,
+						quirks->max_write_len);
+	}
+	if (ts->read_limit < SYNA_MIN_READ_SIZE || ts->write_limit < 3)
+		return dev_err_probe(dev, -EOPNOTSUPP, "I2C transfer limits too small\n");
+
+	ts->avdd = devm_regulator_get(dev, "avdd");
+	if (IS_ERR(ts->avdd))
+		return dev_err_probe(dev, PTR_ERR(ts->avdd), "failed to get AVDD\n");
+	/* Retain the proposed binding name; this is the board's 1.8 V VDDI. */
+	ts->vddi = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(ts->vddi))
+		return dev_err_probe(dev, PTR_ERR(ts->vddi), "failed to get VDDI\n");
+	ts->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ts->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ts->reset_gpio), "failed to get reset\n");
+	ret = syna_power_on(ts);
+	if (ret)
+		return dev_err_probe(dev, ret, "power-on failed\n");
+	ret = devm_add_action_or_reset(dev, syna_power_off, ts);
+	if (ret)
+		return ret;
+	ret = syna_identify(ts);
+	if (ret)
+		return dev_err_probe(dev, ret, "application identification failed\n");
+	ret = syna_get_app_info(ts, &info);
+	if (ret)
+		return dev_err_probe(dev, ret, "APP_INFO not ready\n");
+	ret = syna_check_app_info(ts, &info);
+	if (ret)
+		return ret;
+	ts->max_x = le16_to_cpu(info.max_x);
+	ts->max_y = le16_to_cpu(info.max_y);
+	ts->max_objects = le16_to_cpu(info.max_objects);
+	ts->config_size = le16_to_cpu(info.max_touch_report_config_size);
+	dev_info(dev, "APP_INFO v%u status=0000 native=%ux%u objects=%u config=%u payload=%u\n",
+		 le16_to_cpu(info.version), ts->max_x + 1, ts->max_y + 1,
+		 ts->max_objects, ts->config_size,
+		 le16_to_cpu(info.max_touch_report_payload_size));
+	ret = syna_configure_reports(ts);
+	if (ret)
+		return dev_err_probe(dev, ret, "report setup failed\n");
+
+	/* Allocated after power-on so devres unregisters input before power-off. */
+	ts->input = devm_input_allocate_device(dev);
+	if (!ts->input)
+		return -ENOMEM;
+	ts->input->name = "Synaptics S3908 Touchscreen";
+	ts->input->id.bustype = BUS_I2C;
+	ts->input->dev.parent = dev;
+	input_set_abs_params(ts->input, ABS_MT_POSITION_X, 0, ts->max_x, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_POSITION_Y, 0, ts->max_y, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_TOUCH_MAJOR, 0, 4095, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_TOUCH_MINOR, 0, 4095, 0, 0);
+	touchscreen_parse_properties(ts->input, true, &ts->prop);
+	ret = input_mt_init_slots(ts->input, ts->max_objects,
+				  INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return ret;
+	ret = input_register_device(ts->input);
+	if (ret)
+		return dev_err_probe(dev, ret, "input registration failed\n");
+	ret = devm_request_threaded_irq(dev, client->irq, NULL, syna_irq,
+					IRQF_ONESHOT, "synaptics-tcm-i2c", ts);
+	if (ret)
+		return dev_err_probe(dev, ret, "IRQ registration failed\n");
+	dev_info(dev, "report config verified; IRQ %d enabled\n", client->irq);
+	return 0;
+}
+
+static int syna_suspend(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct syna_tcm *ts = i2c_get_clientdata(client);
+	int ret;
+
+	disable_irq(client->irq);
+	mutex_lock(&ts->lock);
+	ret = syna_exec_command(ts, SYNA_CMD_ENTER_DEEP_SLEEP, NULL, 0);
+	syna_release_contacts(ts);
+	mutex_unlock(&ts->lock);
+	if (ret)
+		enable_irq(client->irq);
+	return ret;
+}
+
+static int syna_resume(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct syna_tcm *ts = i2c_get_clientdata(client);
+	struct syna_app_info info;
+	int ret;
+
+	mutex_lock(&ts->lock);
+	ts->report_configured = false;
+	ret = syna_exec_command(ts, SYNA_CMD_EXIT_DEEP_SLEEP, NULL, 0);
+	if (ret)
+		goto out;
+	ret = syna_get_app_info(ts, &info);
+	if (ret)
+		goto out;
+	ret = syna_check_app_info(ts, &info);
+	if (ret)
+		goto out;
+	if (le16_to_cpu(info.max_x) != ts->max_x ||
+	    le16_to_cpu(info.max_y) != ts->max_y ||
+	    le16_to_cpu(info.max_objects) != ts->max_objects ||
+	    le16_to_cpu(info.max_touch_report_config_size) != ts->config_size) {
+		ret = -EPROTO;
+		goto out;
+	}
+	ret = syna_configure_reports(ts);
+out:
+	if (ret)
+		dev_err(dev, "resume failed, touch input unavailable: %d\n", ret);
+	mutex_unlock(&ts->lock);
+	/* Drain/log IRQs on failure, but never parse an unverified layout. */
+	enable_irq(client->irq);
+	return ret;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(syna_pm_ops, syna_suspend, syna_resume);
+
+static const struct i2c_device_id syna_ids[] = {
+	{ "synaptics-tcm" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, syna_ids);
+
+static const struct of_device_id syna_of_match[] = {
+	{ .compatible = "syna,s3908" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, syna_of_match);
+
+static struct i2c_driver syna_driver = {
+	.driver = {
+		.name = "synaptics-tcm-i2c",
+		.of_match_table = syna_of_match,
+		.pm = pm_sleep_ptr(&syna_pm_ops),
+	},
+	.probe = syna_probe,
+	.id_table = syna_ids,
+};
+module_i2c_driver(syna_driver);
+
+MODULE_DESCRIPTION("Synaptics S3908 TouchComm I2C touchscreen driver");
+MODULE_AUTHOR("Vsevolod Nevorotov");
+MODULE_LICENSE("GPL");
