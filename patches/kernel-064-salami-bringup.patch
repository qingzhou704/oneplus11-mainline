+								 dsc_common_mode);
+		drm_info_once(dpu_enc->base.dev, "DSC 1.2 initial_lines=%u\n", initial_lines);
+	} else {
+		initial_lines = dpu_encoder_dsc_initial_line_calc(dsc, enc_ip_w);
+	}
 
 	for (i = 0; i < num_dsc; i++)
 		dpu_encoder_dsc_pipe_cfg(ctl, hw_dsc[i], hw_pp[i],
