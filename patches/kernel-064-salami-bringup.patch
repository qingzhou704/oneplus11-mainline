diff --git a/drivers/gpu/drm/panel/iris7-bypass.c b/drivers/gpu/drm/panel/iris7-bypass.c
new file mode 100644
index 000000000..701ee381d
--- /dev/null
+++ b/drivers/gpu/drm/panel/iris7-bypass.c
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OnePlus 11 Iris 7 analog-bypass control, owned by the panel device.
+ * Sequence and one-wire protocol derived from OnePlusOSS sm8550, commit
+ * 46a66233a2ce0cf4a9fc61e24ccd158cecfd711f, Pixelworks driver.
+ * Copyright (C) 2017-2020, Pixelworks, Inc. (original protocol implementation)
+ *
+ * No MEMC/PQ firmware, I2C writes, or DSI payload translation. In ABYP the
+ * panel is addressed directly on DSI0. The panel calls the int-returning
+ * sequencing API before sending commands, so a failed transition is fatal
+ * to panel preparation rather than hidden by void DRM bridge callbacks.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+#include "iris7-bypass.h"
+
+/* Fixed Iris one-wire protocol, not a board clock-frequency assumption. */
+#define IRIS7_POR_CLOCK_100KHZ	180
+#define IRIS7_PULSE_US		(16 * 16 * 4 * 10 / IRIS7_POR_CLOCK_100KHZ)
+#define IRIS7_COMMAND_END_US	(16 * 16 * 16 * 10 / IRIS7_POR_CLOCK_100KHZ)
+#define IRIS7_ENTER_ABYP_PULSES	2
+#define IRIS7_READY_POLLS		50
+
+struct iris7_bypass {
+	struct device *dev;
+	struct regulator *v18;
+	struct clk *refclk;
+	struct gpio_desc *v09_enable;
+	struct gpio_desc *vdd_enable;
+	struct gpio_desc *reset;
+	struct gpio_desc *wakeup;
+	struct gpio_desc *abyp_ready;
+	spinlock_t wire_lock;
+	bool supply_enabled;
+	bool clock_enabled;
+};
+
+static void iris7_enter_abyp(struct iris7_bypass *iris)
+{
+	unsigned long flags;
+	int i;
+
+	/* wakeup must be a non-sleeping GPIO (checked when acquiring resources). */
+	spin_lock_irqsave(&iris->wire_lock, flags);
+	for (i = 0; i < IRIS7_ENTER_ABYP_PULSES; i++) {
+		gpiod_set_value(iris->wakeup, 1);
+		udelay(IRIS7_PULSE_US);
+		gpiod_set_value(iris->wakeup, 0);
+		udelay(IRIS7_PULSE_US);
+	}
+	udelay(10);
+	spin_unlock_irqrestore(&iris->wire_lock, flags);
+	udelay(IRIS7_COMMAND_END_US);
+}
+
+int iris7_bypass_power_on(struct iris7_bypass *iris)
+{
+	int ret, err;
+
+	if (iris->supply_enabled)
+		return -EBUSY;
+
+	ret = regulator_enable(iris->v18);
+	if (ret)
+		return ret;
+	iris->supply_enabled = true;
+	ret = gpiod_direction_output(iris->v09_enable, 1);
+	if (ret)
+		goto disable_supply;
+	ret = gpiod_direction_output(iris->vdd_enable, 1);
+	if (ret) {
+		gpiod_set_value_cansleep(iris->v09_enable, 0);
+		goto disable_supply;
+	}
+	ret = clk_prepare_enable(iris->refclk);
+	if (ret) {
+		gpiod_set_value_cansleep(iris->vdd_enable, 0);
+		gpiod_set_value_cansleep(iris->v09_enable, 0);
+		goto disable_supply;
+	}
+	iris->clock_enabled = true;
+	dev_info(iris->dev, "Iris reference clock enabled: %lu Hz\n",
+		 clk_get_rate(iris->refclk));
+	usleep_range(5000, 5100);
+	return 0;
+
+disable_supply:
+	err = regulator_disable(iris->v18);
+	if (err)
+		dev_err(iris->dev, "v18 rollback failed: %d\n", err);
+	else
+		iris->supply_enabled = false;
+	return ret;
+}
+
+int iris7_bypass_reset_and_wait(struct iris7_bypass *iris)
+{
+	int ret, i;
+
+	ret = gpiod_direction_output(iris->wakeup, 0);
+	if (ret)
+		return ret;
+	/* reset descriptor is active-low: logical 1 asserts physical low. */
+	ret = gpiod_direction_output(iris->reset, 1);
+	if (ret)
+		return ret;
+	usleep_range(1000, 1100);
+	gpiod_set_value_cansleep(iris->reset, 0);
+	usleep_range(2000, 2100);
+
+	ret = gpiod_get_value_cansleep(iris->abyp_ready);
+	if (ret < 0)
+		return ret;
+	if (ret) {
+		dev_info(iris->dev, "ABYP ready after controlled reset\n");
+		return 0;
+	}
+
+	/* One deliberate transition; no force command or automatic reset retry. */
+	iris7_enter_abyp(iris);
+	for (i = 0; i < IRIS7_READY_POLLS; i++) {
+		ret = gpiod_get_value_cansleep(iris->abyp_ready);
+		if (ret < 0)
+			return ret;
+		if (ret) {
+			dev_info(iris->dev, "ABYP ready after ENTER_ABYP, poll %d\n", i);
+			return 0;
+		}
+		usleep_range(3000, 3100);
+	}
+
+	dev_err(iris->dev, "ABYP-ready stayed low; panel initialization blocked\n");
+	return -ETIMEDOUT;
+}
+
+int iris7_bypass_power_off(struct iris7_bypass *iris)
+{
+	int ret, err;
+
+	if (!iris->supply_enabled)
+		return 0;
+	ret = gpiod_direction_output(iris->reset, 1);
+	if (ret)
+		dev_err(iris->dev, "failed to assert reset during power-off: %d\n", ret);
+	usleep_range(500, 510);
+	if (iris->clock_enabled) {
+		clk_disable_unprepare(iris->refclk);
+		iris->clock_enabled = false;
+	}
+	gpiod_set_value_cansleep(iris->vdd_enable, 0);
+	gpiod_set_value_cansleep(iris->v09_enable, 0);
+	err = regulator_disable(iris->v18);
+	if (err)
+		dev_err(iris->dev, "failed to disable v18: %d\n", err);
+	else
+		iris->supply_enabled = false;
+	return ret ? ret : err;
+}
+
+static void iris7_cleanup(void *data)
+{
+	struct iris7_bypass *iris = data;
+	int ret = iris7_bypass_power_off(iris);
+
+	if (ret)
+		dev_err(iris->dev, "final power-off failed: %d\n", ret);
+}
+
+struct iris7_bypass *devm_iris7_bypass_get(struct device *dev)
+{
+	struct iris7_bypass *iris;
+	int ret;
+
+	iris = devm_kzalloc(dev, sizeof(*iris), GFP_KERNEL);
+	if (!iris)
+		return ERR_PTR(-ENOMEM);
+	iris->dev = dev;
+	spin_lock_init(&iris->wire_lock);
+	iris->refclk = devm_clk_get(dev, "iris");
+	if (IS_ERR(iris->refclk))
+		return ERR_CAST(iris->refclk);
+	iris->v18 = devm_regulator_get(dev, "iris-v18");
+	if (IS_ERR(iris->v18))
+		return ERR_CAST(iris->v18);
+	ret = regulator_set_load(iris->v18, 62000);
+	if (ret)
+		return ERR_PTR(ret);
+	/* Preserve bootloader output levels until the ordered power sequence. */
+	iris->v09_enable = devm_gpiod_get(dev, "iris-v09-enable", GPIOD_ASIS);
+	if (IS_ERR(iris->v09_enable))
+		return ERR_CAST(iris->v09_enable);
+	iris->vdd_enable = devm_gpiod_get(dev, "iris-vdd-enable", GPIOD_ASIS);
+	if (IS_ERR(iris->vdd_enable))
+		return ERR_CAST(iris->vdd_enable);
+	iris->reset = devm_gpiod_get(dev, "iris-reset", GPIOD_ASIS);
+	if (IS_ERR(iris->reset))
+		return ERR_CAST(iris->reset);
+	iris->wakeup = devm_gpiod_get(dev, "iris-wakeup", GPIOD_ASIS);
+	if (IS_ERR(iris->wakeup))
+		return ERR_CAST(iris->wakeup);
+	if (gpiod_cansleep(iris->wakeup)) {
+		dev_err(dev, "Iris one-wire requires a non-sleeping GPIO\n");
+		return ERR_PTR(-EINVAL);
+	}
+	iris->abyp_ready = devm_gpiod_get(dev, "iris-abyp-ready", GPIOD_IN);
+	if (IS_ERR(iris->abyp_ready))
+		return ERR_CAST(iris->abyp_ready);
+	ret = gpiod_get_value_cansleep(iris->abyp_ready);
+	if (ret < 0)
+		return ERR_PTR(ret);
+	dev_info(dev, "inherited ABYP-ready=%d; controlled sequence pending\n", ret);
+	ret = devm_add_action_or_reset(dev, iris7_cleanup, iris);
+	if (ret)
+		return ERR_PTR(ret);
+	return iris;
+}
