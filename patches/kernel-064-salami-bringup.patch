index cc07fb0a7..e7e8c9ae4 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -575,7 +575,9 @@ static int qcom_battmgr_bat_sm8350_update(struct qcom_battmgr *battmgr,
  * The Kaanapali Oplus firmware describes only its own buck. While the host
  * holds the buck input at zero an external charger owns charging, and the
  * direction of the battery current tells the status. Its power reading is
- * not voltage times current at all, so compute that.
+ * not voltage times current at all, so compute that. The OnePlus 11 (SM8550)
+ * firmware returns one constant for BATT_POWER_NOW whatever the load, so it
+ * takes the computed power too.
  */
 static int qcom_battmgr_bat_oplus_update(struct qcom_battmgr *battmgr,
 					 enum power_supply_property psp)
@@ -667,7 +669,9 @@ static int qcom_battmgr_bat_get_property(struct power_supply *psy,
 	else if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
 		 battmgr->variant == QCOM_BATTMGR_X1E80100)
 		ret = qcom_battmgr_bat_sc8280xp_update(battmgr, psp);
-	else if (battmgr->variant == OPLUS_BATTMGR_KAANAPALI)
+	else if (battmgr->variant == OPLUS_BATTMGR_KAANAPALI ||
+		 (battmgr->variant == OPLUS_BATTMGR_SM8550 &&
+		  psp == POWER_SUPPLY_PROP_POWER_NOW))
 		ret = qcom_battmgr_bat_oplus_update(battmgr, psp);
 	else
 		ret = qcom_battmgr_bat_sm8350_update(battmgr, psp);
