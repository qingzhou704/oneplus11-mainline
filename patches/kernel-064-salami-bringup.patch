From 260944389dc0f9aec8a18e2eff7c6ed6a784955d Mon Sep 17 00:00:00 2001
From: OnePlus 11 mainline port <noreply@localhost>
Date: Wed, 18 Nov 2026 12:15:20 +0800
Subject: [PATCH 07/10] arm64: dts: qcom: sm8550-oneplus-salami: add AudioReach
 sound, speakers, WCD9385 and flash LED

---
 .../boot/dts/qcom/sm8550-oneplus-salami.dts   | 259 ++++++++++++++++++
 1 file changed, 259 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts b/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
index 1d133e8fa..ea506ef2a 100644
--- a/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
+++ b/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
@@ -6,8 +6,11 @@
  */
 /dts-v1/;
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
 #include "sm8550.dtsi"
+#include "pm8550.dtsi"
 #include "pm8550b.dtsi"
 #include "pmk8550.dtsi"
 
@@ -176,6 +179,16 @@ &apps_rsc {
 	regulators-0 {
 		compatible = "qcom,pm8550-rpmh-regulators";
 		qcom,pmic-id = "b";
+		/*
+		 * Stock rpmh-regulator-bobb1 (pm_humu_bob1, phandle 0x30d) supplies
+		 * cdc-vdd-mic-bias: 2 985 984..3 960 768 uV, init 2 700 000 uV.
+		 */
+		vreg_bob1: bob1 {
+			regulator-name = "salami-bob1";
+			regulator-min-microvolt = <2985984>;
+			regulator-max-microvolt = <3960768>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
 		vreg_l5b: ldo5 {
 			regulator-name = "salami-l5b";
 			regulator-min-microvolt = <3104000>;
@@ -523,3 +536,249 @@ iio-hwmon {
 			      <&pmk8550_vadc ADC5_GEN3_AMUX3_GPIO_100K_PU(7)>;
 	};
 };
+
+/*
+ * Rear flash: stock qcom,camera-flash uses flash_0/1 and torch_0/1 together,
+ * i.e. channels 0 and 1 (led-sources are 1-based here). Stock allows 500 mA
+ * per torch channel; the torch total is kept at aston's 500 mA.
+ */
+&pm8550_flash {
+	status = "okay";
+
+	led-0 {
+		function = LED_FUNCTION_FLASH;
+		color = <LED_COLOR_ID_WHITE>;
+		led-sources = <1>, <2>;
+		led-max-microamp = <500000>;
+		flash-max-microamp = <2000000>;
+		/* Stock qcom,duration-ms = 1280. */
+		flash-max-timeout-us = <1280000>;
+		function-enumerator = <0>;
+	};
+};
+
+/*
+ * Audio. Stock uses vendor's qcom,kalama-asoc-snd machine driver, which mainline
+ * does not have; this uses the mainline qcom,sm8550-sndcard instead.
+ *
+ * Speakers: two TFA987x on QUP1 SE6 (stock i2c@a98000, 0x34 tfa_channel 0 and
+ * 0x35 tfa_channel 1) fed by Secondary MI2S (stock oplus,speaker-i2s-id = 1,
+ * aux1_pcm pins). Stock names the supply tfa9874_vdd, but both chips report
+ * TFA9873 revision 0x0b73. Both WSA macros and all four wsa884x are disabled in stock.
+ * Microphones go through the WCD9385. The USB-C analog headset (fsa4480) is
+ * not wired yet.
+ */
+&gpi_dma1 {
+	status = "okay";
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
+&i2c6 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/* Slot 0 (0x34) plays from the top, slot 1 (0x35) from the bottom: checked by ear. */
+	speaker_top: audio-codec@34 {
+		compatible = "nxp,tfa9873";
+		reg = <0x34>;
+		reset-gpios = <&tlmm 50 GPIO_ACTIVE_HIGH>;
+		vddd-supply = <&vreg_l15b>;
+		sound-name-prefix = "Top";
+		#sound-dai-cells = <0>;
+	};
+
+	speaker_bottom: audio-codec@35 {
+		compatible = "nxp,tfa9873";
+		reg = <0x35>;
+		reset-gpios = <&tlmm 173 GPIO_ACTIVE_HIGH>;
+		vddd-supply = <&vreg_l15b>;
+		nxp,tdm-slot = <1>;
+		sound-name-prefix = "Bottom";
+		#sound-dai-cells = <0>;
+	};
+};
+
+&q6apmbedai {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	dai@12 {
+		reg = <SECONDARY_MI2S_RX>;
+		clocks = <&q6prmcc LPASS_CLK_ID_SEC_MI2S_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+		clock-names = "bclk";
+	};
+};
+
+&swr1 {
+	status = "okay";
+
+	/* WCD9385 RX */
+	wcd_rx: codec@0,4 {
+		compatible = "sdw20217010d00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+	};
+};
+
+&swr2 {
+	status = "okay";
+
+	/* WCD9385 TX */
+	wcd_tx: codec@0,3 {
+		compatible = "sdw20217010d00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <2 2 3 4>;
+	};
+};
+
+/ {
+	wcd938x: audio-codec {
+		compatible = "qcom,wcd9385-codec";
+
+		/* Required by qcom,wcd938x.yaml; the reference DTS files omit it and
+		 * only get a warning, but the DAI links need it to resolve.
+		 */
+		#sound-dai-cells = <1>;
+
+		pinctrl-0 = <&wcd_default>;
+		pinctrl-names = "default";
+
+		/* Stock qcom,cdc-micbias{1,2,3,4}-mv = 2700 mV. */
+		qcom,micbias1-microvolt = <2700000>;
+		qcom,micbias2-microvolt = <2700000>;
+		qcom,micbias3-microvolt = <2700000>;
+		qcom,micbias4-microvolt = <2700000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		/* Stock: wcd938x_reset_active/sleep on tlmm gpio108. */
+		reset-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;
+
+		/* Stock phandles: cdc-vdd-buck/rxtx/vddio = pm_humu_l15 (1.8 V),
+		 * cdc-vdd-mic-bias = pm_humu_bob1. Same rails aston uses.
+		 */
+		vdd-buck-supply = <&vreg_l15b>;
+		vdd-rxtx-supply = <&vreg_l15b>;
+		vdd-io-supply = <&vreg_l15b>;
+		vdd-mic-bias-supply = <&vreg_bob1>;
+	};
+
+	sound {
+		compatible = "qcom,sm8550-sndcard", "qcom,sm8450-sndcard";
+		pinctrl-0 = <&i2s1_default>;
+		pinctrl-names = "default";
+
+		/* Card name: also names the topology and the UCM file. */
+		model = "salamisnd";
+
+		audio-routing = "IN1_HPHL", "HPHL_OUT",
+				"IN2_HPHR", "HPHR_OUT",
+				"AMIC1", "MIC BIAS1",
+				"AMIC2", "MIC BIAS2",
+				"AMIC3", "MIC BIAS3",
+				"AMIC4", "MIC BIAS4",
+				"AMIC5", "MIC BIAS3",
+				"TX SWR_INPUT0", "ADC1_OUTPUT",
+				"TX SWR_INPUT1", "ADC2_OUTPUT",
+				"TX SWR_INPUT0", "ADC3_OUTPUT",
+				"TX SWR_INPUT1", "ADC4_OUTPUT";
+
+		secondary-i2s-dai-link {
+			link-name = "Secondary MI2S Playback";
+
+			cpu {
+				sound-dai = <&q6apmbedai SECONDARY_MI2S_RX>;
+			};
+
+			codec {
+				sound-dai = <&speaker_top>, <&speaker_bottom>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		/* The WCD9385 is reached over SoundWire through the LPASS codec DMAs. */
+		wcd-playback-dai-link {
+			link-name = "WCD Playback";
+
+			cpu {
+				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
+			};
+
+			codec {
+				sound-dai = <&wcd938x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		wcd-capture-dai-link {
+			link-name = "WCD Capture";
+
+			cpu {
+				/* The DMA the aston link and the SM8550 topologies use. */
+				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
+			};
+
+			codec {
+				sound-dai = <&wcd938x 1>, <&swr2 0>, <&lpass_txmacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+};
+
+&tlmm {
+	/* Stock aux1_pcm_*_active: clk 121, din 122, ws 123, dout 124. */
+	i2s1_default: i2s1-default-state {
+		sck-pins {
+			pins = "gpio121";
+			function = "i2s1_sck";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data0-pins {
+			pins = "gpio122";
+			function = "i2s1_data0";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		ws-pins {
+			pins = "gpio123";
+			function = "i2s1_ws";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data1-pins {
+			pins = "gpio124";
+			function = "i2s1_data1";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+
+	wcd_default: wcd-reset-n-active-state {
+		pins = "gpio108";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-low;
+	};
+};
+
-- 
