From 9f62148b7b8909b8877647a27868cdd0bf17adcd Mon Sep 17 00:00:00 2001
From: OnePlus 11 mainline port <noreply@localhost>
Date: Sun, 8 Nov 2026 10:09:10 +0800
Subject: [PATCH 04/10] power: supply: qcom_battmgr: report OnePlus SM8550 pack
 voltage and charge sign

The OnePlus 11 battery is two cells in series (stock qcom,vbatt_num = 2).
Its firmware reports one cell's voltage and OCV while BATT_VOLT_MAX
already covers the pack (8.9 V), and it reports charging current as
negative, as stock Android also shows. Userspace therefore saw a
charging phone as discharging at half the real power.

Double the voltage readings and negate the current for the OnePlus
SM8550 variant; POWER_NOW follows. Verified on salami with the stock
charger: 8.41 V, +354 mA, +2.97 W, UPower "charging". The OnePlus Ace 3
(aston) shares the variant and its DT already describes a 6.7 V pack,
but it was not tested here.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_battmgr.c | 22 ++++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index e7e8c9ae4..1d9376b19 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -553,6 +553,16 @@ static const u8 sm8350_bat_prop_map[] = {
 	[POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD] = BATT_CHG_CTRL_END_THR,
 };
 
+/*
+ * The OnePlus SM8550 boards on this variant (salami 2S per stock qcom,vbatt_num;
+ * aston per its 6.7 V design minimum) carry two cells in series, and the firmware
+ * reports one cell's voltage while BATT_VOLT_MAX already covers the pack.
+ */
+static unsigned int oplus_sm8550_cells(struct qcom_battmgr *battmgr)
+{
+	return battmgr->variant == OPLUS_BATTMGR_SM8550 ? 2 : 1;
+}
+
 static int qcom_battmgr_bat_sm8350_update(struct qcom_battmgr *battmgr,
 					  enum power_supply_property psp)
 {
@@ -1797,17 +1807,21 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 			battmgr->status.soh_percent = le32_to_cpu(resp->intval.value);
 			break;
 		case BATT_VOLT_OCV:
-			battmgr->status.voltage_ocv = le32_to_cpu(resp->intval.value);
+			battmgr->status.voltage_ocv = le32_to_cpu(resp->intval.value) *
+						      oplus_sm8550_cells(battmgr);
 			break;
 		case BATT_VOLT_NOW:
-			battmgr->status.voltage_now = le32_to_cpu(resp->intval.value);
+			battmgr->status.voltage_now = le32_to_cpu(resp->intval.value) *
+						      oplus_sm8550_cells(battmgr);
 			break;
 		case BATT_VOLT_MAX:
 			battmgr->info.voltage_max = le32_to_cpu(resp->intval.value);
 			break;
 		case BATT_CURR_NOW:
-			if (battmgr->variant == OPLUS_BATTMGR_KAANAPALI)
-				battmgr->status.current_now = -le32_to_cpu(resp->intval.value); /* FG1 + FG2 */
+			/* Kaanapali: FG1 + FG2. SM8550: firmware reports charging as negative. */
+			if (battmgr->variant == OPLUS_BATTMGR_KAANAPALI ||
+			    battmgr->variant == OPLUS_BATTMGR_SM8550)
+				battmgr->status.current_now = -le32_to_cpu(resp->intval.value);
 			else
 				battmgr->status.current_now = le32_to_cpu(resp->intval.value);
 			break;
