                                                             hwaccel_vaapi->supports_quality_level,
+                                                            hwaccel_vaapi->supports_packed_headers,
                                                             source_width, source_height,
                                                             refresh_rate, error);
 }
@@ -254,18 +256,36 @@
       return FALSE;
     }
 
-  g_assert (attributes[3].type == VAConfigAttribEncPackedHeaders);
-  if (attributes[3].value == VA_ATTRIB_NOT_SUPPORTED ||
-      !(attributes[3].value & VA_ENC_PACKED_HEADER_SEQUENCE) ||
-      !(attributes[3].value & VA_ENC_PACKED_HEADER_PICTURE) ||
-      !(attributes[3].value & VA_ENC_PACKED_HEADER_SLICE) ||
-      !(attributes[3].value & VA_ENC_PACKED_HEADER_RAW_DATA))
-    {
-      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
-                   "Unsuitable device, device does not support required packed "
-                   "headers (only supports 0x%08X)", attributes[3].value);
-      return FALSE;
-    }
+  {
+    const uint32_t required_packed_headers =
+      VA_ENC_PACKED_HEADER_SEQUENCE |
+      VA_ENC_PACKED_HEADER_PICTURE |
+      VA_ENC_PACKED_HEADER_SLICE |
+      VA_ENC_PACKED_HEADER_RAW_DATA;
+
+    g_assert (attributes[3].type == VAConfigAttribEncPackedHeaders);
+    if (attributes[3].value == VA_ATTRIB_NOT_SUPPORTED)
+      {
+        g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                     "Unsuitable device, invalid packed headers attribute");
+        return FALSE;
+      }
+    if ((attributes[3].value & required_packed_headers) == required_packed_headers)
+      {
+        hwaccel_vaapi->supports_packed_headers = TRUE;
+      }
+    else if (attributes[3].value == VA_ENC_PACKED_HEADER_NONE)
+      {
+        hwaccel_vaapi->supports_packed_headers = FALSE;
+      }
+    else
+      {
+        g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                     "Unsuitable device, device does not support required packed "
+                     "headers (only supports 0x%08X)", attributes[3].value);
+        return FALSE;
+      }
+  }
 
   g_debug ("[HWAccel.VAAPI] Using VAEntrypoint %i for profile "
            "VAProfileH264High", entrypoint);
