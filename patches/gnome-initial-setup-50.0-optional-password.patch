+static void
+password_skip_response (AdwMessageDialog *dialog, const gchar *response, GisPasswordPage *page)
+{
+  gboolean confirmed = g_str_equal (response, "confirm");
+  page->skip_password_confirmed = confirmed;
+  gtk_window_destroy (GTK_WINDOW (dialog));
+  gis_page_apply_complete (GIS_PAGE (page), confirmed);
