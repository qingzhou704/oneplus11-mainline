+
+static gboolean
+gis_password_page_apply (GisPage *gis_page, GCancellable *cancellable)
+{
+  GisPasswordPage *page = GIS_PASSWORD_PAGE (gis_page);
+  const gchar *password = gtk_editable_get_text (GTK_EDITABLE (page->password_entry));
+  const gchar *verify = gtk_editable_get_text (GTK_EDITABLE (page->confirm_entry));
+  if (!page->parent_mode && *password == '\0' && *verify == '\0') {
+    GtkWindow *parent = GTK_WINDOW (gtk_widget_get_root (GTK_WIDGET (page)));
+    GtkWidget *dialog = adw_message_dialog_new (parent, "不设置密码？",
+      "不设置密码将自动登录，安装软件和修改系统无需密码。拿到设备的人可以访问文件并管理系统。是否确认继续？");
+    page->skip_password_confirmed = FALSE;
+    adw_message_dialog_add_responses (ADW_MESSAGE_DIALOG (dialog),
+                                     "cancel", "取消", "confirm", "确认", NULL);
+    adw_message_dialog_set_response_appearance (ADW_MESSAGE_DIALOG (dialog), "cancel", ADW_RESPONSE_SUGGESTED);
+    adw_message_dialog_set_response_appearance (ADW_MESSAGE_DIALOG (dialog), "confirm", ADW_RESPONSE_DEFAULT);
+    adw_message_dialog_set_default_response (ADW_MESSAGE_DIALOG (dialog), "cancel");
+    adw_message_dialog_set_close_response (ADW_MESSAGE_DIALOG (dialog), "cancel");
+    g_signal_connect_object (dialog, "response", G_CALLBACK (password_skip_response), page, 0);
+    gtk_window_present (GTK_WINDOW (dialog));
+    return TRUE;
+  }
+  page->skip_password_confirmed = FALSE;
+  return FALSE;
 }
 
