From a3e8021a7ce8184d0c946267a2dc0a78e03713a3 Mon Sep 17 00:00:00 2001
From: OnePlus 11 mainline port <noreply@localhost>
Date: Thu, 19 Nov 2026 23:43:05 +0800
Subject: [PATCH] thermal/drivers/qcom/spmi-temp-alarm: preserve
 thermal_trip->priv for OF cooling-map binding

---
 drivers/thermal/qcom/qcom-spmi-temp-alarm.c | 38 ++++++++++++++++-----
 1 file changed, 30 insertions(+), 8 deletions(-)

diff --git a/drivers/thermal/qcom/qcom-spmi-temp-alarm.c b/drivers/thermal/qcom/qcom-spmi-temp-alarm.c
index fb003ca96..ac0860c36 100644
--- a/drivers/thermal/qcom/qcom-spmi-temp-alarm.c
+++ b/drivers/thermal/qcom/qcom-spmi-temp-alarm.c
@@ -140,6 +140,7 @@ struct qpnp_tm_chip {
 	unsigned int			stage;
 	unsigned int			base;
 	unsigned int			ntrips;
+	const struct thermal_trip	*trips[STAGE_COUNT];
 	/* protects .thresh, .stage and chip registers */
 	struct mutex			lock;
 	bool				initialized;
@@ -404,15 +405,31 @@ static int qpnp_tm_gen2_rev2_set_temp_thresh(struct qpnp_tm_chip *chip, unsigned
 	return 0;
 }
 
+/* Caller must hold chip->lock. */
+static int qpnp_tm_trip_index(struct qpnp_tm_chip *chip,
+			      const struct thermal_trip *trip)
+{
+	unsigned int i;
+
+	for (i = 0; i < chip->ntrips && i < STAGE_COUNT; i++)
+		if (chip->trips[i] == trip)
+			return i;
+
+	return -EINVAL;
+}
+
 static int qpnp_tm_gen2_rev2_set_trip_temp(struct thermal_zone_device *tz,
 					   const struct thermal_trip *trip, int temp)
 {
-	unsigned int trip_index = THERMAL_TRIP_PRIV_TO_INT(trip->priv);
 	struct qpnp_tm_chip *chip = thermal_zone_device_priv(tz);
-	int ret;
+	int trip_index, ret;
 
 	mutex_lock(&chip->lock);
-	ret = qpnp_tm_gen2_rev2_set_temp_thresh(chip, trip_index, temp);
+	trip_index = qpnp_tm_trip_index(chip, trip);
+	if (trip_index < 0)
+		ret = trip_index;
+	else
+		ret = qpnp_tm_gen2_rev2_set_temp_thresh(chip, trip_index, temp);
 	mutex_unlock(&chip->lock);
 
 	return ret;
@@ -499,12 +516,15 @@ static int qpnp_tm_lite_set_temp_thresh(struct qpnp_tm_chip *chip, unsigned int
 static int qpnp_tm_lite_set_trip_temp(struct thermal_zone_device *tz,
 				      const struct thermal_trip *trip, int temp)
 {
-	unsigned int trip_index = THERMAL_TRIP_PRIV_TO_INT(trip->priv);
 	struct qpnp_tm_chip *chip = thermal_zone_device_priv(tz);
-	int ret;
+	int trip_index, ret;
 
 	mutex_lock(&chip->lock);
-	ret = qpnp_tm_lite_set_temp_thresh(chip, trip_index, temp);
+	trip_index = qpnp_tm_trip_index(chip, trip);
+	if (trip_index < 0)
+		ret = trip_index;
+	else
+		ret = qpnp_tm_lite_set_temp_thresh(chip, trip_index, temp);
 	mutex_unlock(&chip->lock);
 
 	return ret;
@@ -563,7 +583,8 @@ static int qpnp_tm_gen2_rev2_configure_trip_temps_cb(struct thermal_trip *trip,
 	int ret;
 
 	mutex_lock(&chip->lock);
-	trip->priv = THERMAL_INT_TO_TRIP_PRIV(chip->ntrips);
+	if (chip->ntrips < STAGE_COUNT)
+		chip->trips[chip->ntrips] = trip;
 	ret = qpnp_tm_gen2_rev2_set_temp_thresh(chip, chip->ntrips, trip->temperature);
 	chip->ntrips++;
 	mutex_unlock(&chip->lock);
@@ -617,7 +638,8 @@ static int qpnp_tm_lite_configure_trip_temps_cb(struct thermal_trip *trip, void
 	int ret;
 
 	mutex_lock(&chip->lock);
-	trip->priv = THERMAL_INT_TO_TRIP_PRIV(chip->ntrips);
+	if (chip->ntrips < STAGE_COUNT)
+		chip->trips[chip->ntrips] = trip;
 	ret = qpnp_tm_lite_set_temp_thresh(chip, chip->ntrips, trip->temperature);
 	chip->ntrips++;
 	mutex_unlock(&chip->lock);
-- 
2.43.0

