// SPDX-License-Identifier: GPL-2.0-only
// GNOME Remote Login has no local seat. Allow active remote administrators to
// manage connections as they could at the local desktop, without scan prompts.
polkit.addRule(function(action, subject) {
    if (subject.active && !subject.local && subject.isInGroup("sudo") &&
        (action.id == "org.freedesktop.NetworkManager.wifi.scan" ||
         action.id == "org.freedesktop.NetworkManager.enable-disable-wifi" ||
         action.id == "org.freedesktop.NetworkManager.enable-disable-wwan" ||
         action.id == "org.freedesktop.NetworkManager.network-control" ||
         action.id == "org.freedesktop.NetworkManager.settings.modify.own" ||
         action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
         action.id == "org.freedesktop.ModemManager1.Device.Control")) {
        return polkit.Result.YES;
    }
});
