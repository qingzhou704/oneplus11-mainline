// SPDX-License-Identifier: GPL-2.0-only
// Allow active local or remote administrators (sudo group) to toggle the
// phone's physical screen DPMS or synchronized panel/touch refresh rate from
// the top-bar tray without requiring passwordless sudoers.
polkit.addRule(function(action, subject) {
    if (subject.active && subject.isInGroup("sudo") &&
        action.id === "org.freedesktop.policykit.exec" &&
        (action.lookup("program") === "/usr/bin/salami-ctl" ||
         action.lookup("program") === "/usr/lib/salami/salami-ctl")) {
        return polkit.Result.YES;
    }
});
