[Unit]
Description=Set this phone's factory Bluetooth address on %I
ConditionPathExists=/var/lib/salami/bluetooth-address
BindsTo=sys-subsystem-bluetooth-devices-%i.device
After=sys-subsystem-bluetooth-devices-%i.device

[Service]
Type=oneshot
ExecStart=/usr/lib/salami/bluetooth-address %I
TimeoutStartSec=25
