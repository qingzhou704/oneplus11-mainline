[Unit]
Description=Import this phone's GPU and video firmware from read-only vendor_a
ConditionPathExists=|!/usr/lib/firmware/qcom/sm8550/oneplus/salami/a740_zap.mbn
ConditionPathExists=|!/usr/lib/firmware/qcom/sm8550/oneplus/salami/vpu30_4v.mbn
Requires=dev-disk-by\x2dpartlabel-super.device
After=dev-disk-by\x2dpartlabel-super.device
Before=display-manager.service gnome-remote-desktop.service

[Service]
Type=oneshot
ExecStart=/usr/lib/salami/import-gpu-firmware

[Install]
WantedBy=multi-user.target
