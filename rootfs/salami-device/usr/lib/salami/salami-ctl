def _run_cmd(argv: list[str]) -> str:
    try:
        res = subprocess.run(argv, capture_output=True, text=True, timeout=5)
        return res.stdout.strip() if res.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def _query_systemd_units(units: list[str]) -> dict[str, dict[str, str]]:
    """Fetch UnitFileState and ActiveState for many systemd units in a single subprocess call."""
    if not units:
        return {}
    raw = _run_cmd(
        ["systemctl", "show", "--property=Id,UnitFileState,ActiveState", "--", *units]
    )
    info: dict[str, dict[str, str]] = {}
    if not raw:
        return info
    cur: dict[str, str] = {}
    for line in raw.splitlines():
        if not line.strip():
            unit_id = cur.get("Id")
            if unit_id:
                info[unit_id] = cur
            cur = {}
            continue
        if "=" in line:
            k, v = line.split("=", 1)
            cur[k.strip()] = v.strip()
    if cur.get("Id"):
        info[cur["Id"]] = cur
    return info


def discover_managed_services(
    paths: SysfsPaths = SysfsPaths(),
    *,
    unit_states: dict[str, dict[str, str]] | None = None,
) -> list[tuple[str, str, str]]:
    """Return enabled optional server units plus operator-defined entries from /etc/salami/services.conf."""
    entries: list[tuple[str, str, str]] = []
    seen: set[str] = set()
    if paths.services_conf.is_file():
        for raw_line in _read_str(paths.services_conf).splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            parts = [p.strip() for p in line.split("|")]
            if len(parts) == 3 and _UNIT_NAME_RE.fullmatch(parts[0]) and parts[2] in ("restart", "reload"):
                entries.append((parts[0], parts[1], parts[2]))
                seen.add(parts[0])
    optional_units = [u for u, _lbl, _act in OPTIONAL_SERVER_UNITS if u not in seen]
    states = unit_states if unit_states is not None else _query_systemd_units(optional_units)
    for unit, label, action in OPTIONAL_SERVER_UNITS:
        if unit in seen:
            continue
        st = states.get(unit) or {}
        uf_state = st.get("UnitFileState", "")
        act_state = st.get("ActiveState", "")
        if uf_state in ("enabled", "enabled-runtime") or act_state == "active":
            entries.append((unit, label, action))
            seen.add(unit)
    return entries


def collect_modem_status() -> dict[str, Any]:
    raw = _run_cmd(["mmcli", "-m", "any", "-J"])
    cell_ip_raw = _run_cmd(["ip", "-4", "-br", "addr", "show", "dev", "qmapmux0.0"])
    cell_ip = cell_ip_raw.split()[2] if len(cell_ip_raw.split()) >= 3 else ""
    if not raw:
        return {
            "present": False,
            "state": "absent",
            "power_state": "unknown",
            "registration": "unknown",
            "operator_code": "",
            "operator_name": "",
            "access_tech": "",
            "signal_pct": None,
            "sim_present": False,
            "ip": cell_ip,
        }
    try:
        m = json.loads(raw).get("modem") or {}
    except json.JSONDecodeError:
        return {
            "present": False,
            "state": "parse-error",
            "power_state": "unknown",
            "registration": "unknown",
            "operator_code": "",
            "operator_name": "",
            "access_tech": "",
            "signal_pct": None,
            "sim_present": False,
            "ip": cell_ip,
        }
    gen = m.get("generic") or {}
    gpp = m.get("3gpp") or {}
    op_code = str(gpp.get("operator-code") or "").replace("--", "").strip()
    op_name = str(gpp.get("operator-name") or "").replace("--", "").strip()
    if not op_name and op_code in PLMN_NAMES:
        op_name = PLMN_NAMES[op_code]
    sig_raw = (gen.get("signal-quality") or {}).get("value")
    sig_pct = int(sig_raw) if str(sig_raw).isdigit() else None
    rats = [r for r in (gen.get("access-technologies") or []) if r and r != "--"]
    sim_path = str(gen.get("sim") or "")
    return {
        "present": True,
        "state": str(gen.get("state") or "unknown"),
        "power_state": str(gen.get("power-state") or "unknown"),
        "registration": str(gpp.get("registration-state") or "unknown").replace("--", "unknown"),
        "operator_code": op_code,
        "operator_name": op_name,
        "access_tech": "/".join(rats),
        "signal_pct": sig_pct,
        "sim_present": bool(sim_path and sim_path not in ("--", "/")),
        "ip": cell_ip,
    }


def recover_modem() -> dict[str, Any]:
    """Cycle X70 QMI radio low-power -> on to clear EMM #18 / no-carrier search deadlocks."""
    subprocess.run(["mmcli", "-m", "any", "-d"], capture_output=True, text=True, timeout=10)
    subprocess.run(["mmcli", "-m", "any", "--set-power-state-low"], capture_output=True, text=True, timeout=10)
    select.select([], [], [], 2.0)
    subprocess.run(["mmcli", "-m", "any", "--set-power-state-on"], capture_output=True, text=True, timeout=10)
    subprocess.run(["mmcli", "-m", "any", "-e"], capture_output=True, text=True, timeout=10)
    subprocess.run(["nmcli", "connection", "up", "mobile"], capture_output=True, text=True, timeout=12)
    for _ in range(8):
        st = collect_modem_status()
        if st["state"] == "connected" and st["ip"]:
            return st
        select.select([], [], [], 1.0)
    return collect_modem_status()


def guard_modem(
    paths: SysfsPaths = SysfsPaths(),
    *,
    now: float | None = None,
    status_fn=collect_modem_status,
    recover_fn=recover_modem,
) -> dict[str, Any]:
    """Self-heal wedged X70 cellular registration with consecutive-check confirmation and backoff."""
    ts_now = time.time() if now is None else now
    state_data: dict[str, Any] = {"consecutive_stuck": 0, "backoff_idx": 0, "next_allowed_ts": 0.0}
    if paths.modem_guard_state.is_file():
        try:
            loaded = json.loads(_read_str(paths.modem_guard_state))
            if isinstance(loaded, dict):
                state_data.update(loaded)
        except json.JSONDecodeError:
            pass

    st = status_fn()
    if not st.get("present") or not st.get("sim_present") or st.get("power_state") != "on" or st.get("state") == "disabled":
        state_data = {"consecutive_stuck": 0, "backoff_idx": 0, "next_allowed_ts": 0.0}
        action = "idle"
    elif st.get("state") == "connected" and st.get("ip"):
        state_data = {"consecutive_stuck": 0, "backoff_idx": 0, "next_allowed_ts": 0.0}
        action = "healthy"
    else:
        stuck = int(state_data.get("consecutive_stuck", 0)) + 1
        next_ts = float(state_data.get("next_allowed_ts", 0.0))
        b_idx = int(state_data.get("backoff_idx", 0))
        if stuck >= 2 and ts_now >= next_ts:
            st = recover_fn()
            backoffs = (240.0, 600.0, 1800.0)
            wait_s = backoffs[min(b_idx, len(backoffs) - 1)]
            if st.get("state") == "connected" and st.get("ip"):
                state_data = {"consecutive_stuck": 0, "backoff_idx": 0, "next_allowed_ts": 0.0}
                action = "recovered"
            else:
                state_data = {"consecutive_stuck": 0, "backoff_idx": b_idx + 1, "next_allowed_ts": ts_now + wait_s}
                action = "recover-attempted"
        else:
            state_data["consecutive_stuck"] = stuck
            action = "monitoring"

    try:
        paths.modem_guard_state.parent.mkdir(parents=True, exist_ok=True)
        paths.modem_guard_state.write_text(json.dumps(state_data), encoding="utf-8")
    except OSError:
        pass
    return {"action": action, "modem": st, "guard_state": state_data}


