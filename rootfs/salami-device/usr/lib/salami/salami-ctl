)


def collect_security_status(paths: SysfsPaths = SysfsPaths()) -> dict[str, Any]:
    sysctls: dict[str, dict[str, Any]] = {}
    hardened_ok = 0
    hardened_total = 0
    for rel, expected in SECURITY_SYSCTL_EXPECT:
        p = paths.proc_sys_dir / rel
        if not p.is_file() or not os.access(p, os.R_OK):
            continue
        hardened_total += 1
        actual = _read_str(p)
        ok = actual == expected
        if ok:
            hardened_ok += 1
        sysctls[rel.replace("/", ".")] = {"actual": actual, "expected": expected, "ok": ok}

    cpu_vulns: dict[str, str] = {}
    cpu_vulnerable_list: list[str] = []
    if paths.cpu_vuln_dir.is_dir():
        for vf in sorted(paths.cpu_vuln_dir.iterdir()):
            if vf.is_file():
                val = _read_str(vf)
                cpu_vulns[vf.name] = val
                if val.lower().startswith("vulnerable"):
                    cpu_vulnerable_list.append(vf.name)

    nft_active = (
        _run_cmd(["systemctl", "is-active", "nftables.service"]) == "active"
        if paths.proc_sys_dir == SysfsPaths.proc_sys_dir
        else True
    )
    kernel_pkg_ver = (
        _run_cmd(["dpkg-query", "-W", "-f=${Version}", f"linux-image-{os.uname().release}"])
        if paths.proc_sys_dir == SysfsPaths.proc_sys_dir
        else ""
    )
    return {
        "kernel_release": os.uname().release if hasattr(os, "uname") else "unknown",
        "kernel_pkg_version": kernel_pkg_ver,
        "sysctl_ok": hardened_ok,
        "sysctl_total": hardened_total,
        "sysctls": sysctls,
        "cpu_vulnerabilities": cpu_vulns,
        "cpu_unmitigated": cpu_vulnerable_list,
        "nftables_active": nft_active,
    }


def format_security_status(sec: dict[str, Any]) -> str:
    pkg_part = f" (模块包 v{sec['kernel_pkg_version']})" if sec.get("kernel_pkg_version") else ""
    cpu_ok = len(sec["cpu_vulnerabilities"]) - len(sec["cpu_unmitigated"])
    cpu_total = len(sec["cpu_vulnerabilities"])
    unmitigated = sec["cpu_unmitigated"]
    if unmitigated:
        cpu_note = f" ({len(unmitigated)} 项未缓解: {', '.join(unmitigated)})"
    else:
        cpu_note = " (Spectre v1/v2 CSV2+BHB / SSB 均已缓解，0 项未防护)"
    fw_str = "运行中 (active)" if sec["nftables_active"] else "未启用"
    failed_keys = [k for k, v in sec["sysctls"].items() if not v["ok"]]
    fail_note = f" (未达标: {', '.join(failed_keys)})" if failed_keys else " (全部就绪)"
    lines = [
        "=== 内核 CVE 免疫与系统安全加固状态 ===",
        f"当前内核 : {sec['kernel_release']}{pkg_part} | 防火墙 nftables: {fw_str}",
        f"CPU 硬件免疫 : {cpu_ok}/{cpu_total} 项受保护{cpu_note}",
        f"内核加固参数 : {sec['sysctl_ok']}/{sec['sysctl_total']} 项生效{fail_note}",
    ]
    return "\n".join(lines)


def collect_net_and_services(paths: SysfsPaths = SysfsPaths()) -> dict[str, Any]:
    routes = _run_cmd(["ip", "-4", "route", "show", "default"]).splitlines()
    wifi_ip = _run_cmd(["ip", "-4", "-br", "addr", "show", "dev", "wlp1s0"])
    cell_ip = _run_cmd(["ip", "-4", "-br", "addr", "show", "dev", "qmapmux0.0"])
    wifi_ps = _run_cmd(["/usr/sbin/iw", "dev", "wlp1s0", "get", "power_save"]) or _run_cmd(
        ["iw", "dev", "wlp1s0", "get", "power_save"]
    )
    nm_conn = _run_cmd(["nmcli", "networking", "connectivity"]) or "unknown"
    modem = collect_modem_status()

    # Batch query all base, optional, and custom units in a single systemctl call.
    candidate_units: list[str] = list(BASE_HEALTH_UNITS)
    for u, _lbl, _act in OPTIONAL_SERVER_UNITS:
        if u not in candidate_units:
            candidate_units.append(u)
    if paths.services_conf.is_file():
        for raw_line in _read_str(paths.services_conf).splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            parts = [p.strip() for p in line.split("|")]
            if len(parts) == 3 and _UNIT_NAME_RE.fullmatch(parts[0]) and parts[0] not in candidate_units:
                candidate_units.append(parts[0])
    unit_states = _query_systemd_units(candidate_units)

    managed = discover_managed_services(paths, unit_states=unit_states)
    units_to_check = list(BASE_HEALTH_UNITS)
    for unit, _label, _act in managed:
        if unit not in units_to_check:
            units_to_check.append(unit)
    services: dict[str, str] = {}
    for unit in units_to_check:
        state = (unit_states.get(unit) or {}).get("ActiveState") or "inactive"
        services[unit.removesuffix(".service")] = state
    return {
        "connectivity": nm_conn,
        "default_routes": routes,
        "wifi_wlp1s0": wifi_ip,
        "wifi_power_save": wifi_ps.replace("Power save:", "").strip() or "unknown",
        "cellular_qmapmux0": cell_ip,
        "modem": modem,
        "tcp": f"{_read_str(paths.proc_tcp_cc, '?')} + {_read_str(paths.proc_qdisc, '?')}",
        "services": services,
        "managed_actions": [{"unit": u, "label": l, "verb": v} for u, l, v in managed],
    }


def format_net_and_services(info: dict[str, Any]) -> str:
    svc_parts = [f"{k}={'OK' if v == 'active' else v}" for k, v in info["services"].items()]
    primary = info["default_routes"][0] if info["default_routes"] else "无默认路由"
    lines = [
        "=== 双网出口与服务器守护状态 ===",
        f"联网状态 : {info['connectivity']} | 主默认路由: {primary}",
        f"Wi-Fi    : {info['wifi_wlp1s0'] or '未连接'} (省电休眠: {info['wifi_power_save']})",
        f"5G 蜂窝  : {info['cellular_qmapmux0'] or '未连接'} | 拥塞控制: {info['tcp']}",
        f"核心服务 : {' | '.join(svc_parts)}",
    ]
    return "\n".join(lines)


def set_charge_limit(limit: int, paths: SysfsPaths = SysfsPaths()) -> tuple[int, int]:
    if not 50 <= limit <= 100:
        raise ValueError("充电上限须在 50 到 100 之间")
    start = max(0, limit - 5)
    start_path = paths.bat_dir / "charge_control_start_threshold"
    end_path = paths.bat_dir / "charge_control_end_threshold"
    cur_start = _read_int(start_path, 0) or 0
    cur_end = _read_int(end_path, 100) or 100

    if limit >= cur_end and start > cur_end:
        end_path.write_text(f"{limit}\n", encoding="utf-8")
        start_path.write_text(f"{start}\n", encoding="utf-8")
    elif limit < cur_start:
        start_path.write_text(f"{start}\n", encoding="utf-8")
        end_path.write_text(f"{limit}\n", encoding="utf-8")
    else:
        end_path.write_text(f"{limit}\n", encoding="utf-8")
        start_path.write_text(f"{start}\n", encoding="utf-8")
    return start, limit


def _manage_restore_timer(hours: float | None, script_path: str) -> str | None:
    scope = ["--system"] if os.geteuid() == 0 else ["--user"]
    subprocess.run(
        ["systemctl", *scope, "stop", f"{RESTORE_TIMER_UNIT}.timer", f"{RESTORE_TIMER_UNIT}.service"],
        capture_output=True,
        text=True,
    )
    subprocess.run(
        ["systemctl", *scope, "reset-failed", f"{RESTORE_TIMER_UNIT}.timer", f"{RESTORE_TIMER_UNIT}.service"],
        capture_output=True,
        text=True,
    )
    if hours is None:
        return None
    if hours <= 0 or hours > 168:
        raise ValueError("--hours 须在 (0, 168] 小时范围内")
    seconds = max(1, round(hours * 3600))
    subprocess.run(
        [
            "systemd-run",
            *scope,
            f"--unit={RESTORE_TIMER_UNIT}",
            f"--on-active={seconds}s",
            "--description=Restore OnePlus 11 80% battery charge ceiling",
            script_path,
            "charge",
            "80",
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    return f"已设定 {hours:g} 小时后自动恢复 75–80% 护航限充（{RESTORE_TIMER_UNIT}.timer）"


def set_torch(action: str, level: int | None = None, paths: SysfsPaths = SysfsPaths()) -> int:
    br_path = paths.torch_dir / "brightness"
    max_br = _read_int(paths.torch_dir / "max_brightness", 255) or 255
    cur = _read_int(br_path, 0) or 0

    if action == "status":
        return cur
    if action == "off":
        target = 0
    elif action == "on":
        raw = DEFAULT_TORCH_BRIGHTNESS if level is None else level
        target = max(1, min(max_br, raw))
    elif action == "toggle":
        if cur > 0:
            target = 0
        else:
            raw = DEFAULT_TORCH_BRIGHTNESS if level is None else level
            target = max(1, min(max_br, raw))
    else:
        raw = int(action)
        if raw < 0 or raw > max_br:
            raise ValueError(f"手电筒亮度须在 0..{max_br} 之间")
        target = raw

    br_path.write_text(f"{target}\n", encoding="utf-8")
    return target


def set_brightness(spec: str, paths: SysfsPaths = SysfsPaths()) -> tuple[int, int]:
    br_path = paths.backlight_dir / "brightness"
    max_br = _read_int(paths.backlight_dir / "max_brightness", 2047) or 2047
    cur = _read_int(br_path, 0) or 0
    cur_pct = max(1, round(cur * 100.0 / max_br)) if max_br > 0 else 50

    if spec == "status":
        return cur, round(cur * 100.0 / max_br) if max_br > 0 else 0
    if spec.startswith(("+", "-")):
        target_pct = cur_pct + int(spec)
    else:
        target_pct = int(spec.rstrip("%"))
    target_pct = max(1, min(100, target_pct))
    raw = max(20, min(max_br, round(target_pct * max_br / 100.0)))
    br_path.write_text(f"{raw}\n", encoding="utf-8")
    return raw, target_pct


def find_haptics_device(paths: SysfsPaths = SysfsPaths()) -> Path:
    if paths.sys_input.is_dir():
        for entry in sorted(paths.sys_input.glob("event*")):
            if _read_str(entry / "device" / "name") == "qcom-spmi-haptics":
                dev = paths.dev_input / entry.name
                if dev.exists():
                    return dev
    raise FileNotFoundError("未找到 qcom-spmi-haptics 线性马达设备")


def trigger_vibrate(duration_ms: int = 60, paths: SysfsPaths = SysfsPaths()) -> None:
    if not 15 <= duration_ms <= 1000:
        raise ValueError("震动时长须在 15..1000 ms 之间")
    dev = find_haptics_device(paths)
    effect = bytearray(48)
    struct.pack_into("<HhHHHHHH", effect, 0, FF_RUMBLE, -1, 0, 0, 0, duration_ms, 0, 0)
    struct.pack_into("<HH", effect, 16, 0x6000, 0x3000)

    fd = os.open(str(dev), os.O_RDWR)
    effect_id = -1
    try:
        fcntl.ioctl(fd, EVIOCSFF, effect, True)
        effect_id = struct.unpack_from("<h", effect, 2)[0]
        os.write(fd, EVENT_STRUCT.pack(0, 0, EV_FF, effect_id, 1))
        select.select([], [], [], duration_ms / 1000.0 + 0.02)
        os.write(fd, EVENT_STRUCT.pack(0, 0, EV_FF, effect_id, 0))
    finally:
        if effect_id >= 0:
            try:
                fcntl.ioctl(fd, EVIOCRMFF, effect_id)
            except OSError:
                pass
        os.close(fd)


def _disk_usage_pct(mount_path: Path) -> tuple[float, float, float] | None:
    if not mount_path.exists():
        return None
    try:
        du = shutil.disk_usage(mount_path)
    except OSError:
        return None
    if du.total <= 0:
        return None
    used_pct = round(du.used * 100.0 / du.total, 1)
    free_gib = round(du.free / (1024**3), 1)
    total_gib = round(du.total / (1024**3), 1)
    return used_pct, free_gib, total_gib


def collect_doctor_report(
    paths: SysfsPaths = SysfsPaths(),
    *,
    live_override: bool | None = None,
) -> dict[str, Any]:
    """Run read-only full-stack diagnostics across kernel, power, thermal, display, video, I/O, net, and security."""
    live = (paths.bat_dir == SysfsPaths.bat_dir) if live_override is None else live_override
    status = collect_status(paths)
    sec = collect_security_status(paths)
    checks: list[dict[str, str]] = []

    def add(cid: str, name: str, level: str, detail: str, hint: str = "") -> None:
        checks.append({"id": cid, "name": name, "status": level, "detail": detail, "hint": hint})

    # 1. Boot & systemd units
    krel = sec["kernel_release"]
    if live:
        failed_raw = _run_cmd(["systemctl", "--failed", "--no-legend", "--plain"])
        failed_units = [line.split()[0] for line in failed_raw.splitlines() if line.strip()]
        if failed_units:
            add(
                "boot_systemd",
                "内核与系统服务",
                "FAIL",
                f"内核 {krel}，存在 {len(failed_units)} 个失败单元: {', '.join(failed_units[:4])}",
                "执行 `systemctl --failed` 与 `journalctl -u <unit>` 排查失败原因",
            )
        else:
            add("boot_systemd", "内核与系统服务", "PASS", f"内核 {krel}，0 个失败 systemd 单元")
    else:
        add("boot_systemd", "内核与系统服务", "PASS", f"内核 {krel} (离线检查模式)")

    # 2. Battery & charging safety
    bat = status["battery"]
    b_cap = bat["capacity_pct"]
    b_temp = bat["temp_c"]
    b_start = bat["start_threshold_pct"]
    b_end = bat["end_threshold_pct"]
    if b_cap is None:
        add("battery", "电池与快充", "FAIL", "未读取到 qcom-battmgr-bat 电池节点", "检查 qcom_battmgr 模块与 ADSP 固件加载")
    elif b_start is not None and b_end is not None and b_start > b_end:
        add(
            "battery",
            "电池与快充",
            "FAIL",
            f"限充区间异常 start={b_start}% > end={b_end}%",
            "执行 `salami-ctl charge 80` 重置合法限充区间",
        )
    elif b_temp is not None and b_temp >= 52.0:
        add(
            "battery",
            "电池与快充",
            "FAIL",
            f"电池过热 {b_temp} °C (电量 {b_cap}%)",
            "立即停止高负载或执行 `salami-ctl vooc off` 切回 10W 慢充降温",
        )
    elif b_temp is not None and b_temp >= 45.0:
        add(
            "battery",
            "电池与快充",
            "WARN",
            f"电池温度偏高 {b_temp} °C (电量 {b_cap}%，限充 {b_start}–{b_end}%)",
            "建议切换 `salami-ctl vooc off` 或降低负载",
        )
    else:
        vooc_txt = "SUPERVOOC 开启" if bat["vooc_enabled"] else "10W 慢充"
        add(
            "battery",
            "电池与快充",
            "PASS",
            f"电量 {b_cap}% ({bat['status']})，电池 {b_temp} °C，限充 {b_start}–{b_end}%，{vooc_txt}",
        )

    # 3. Thermals
    th = status["thermals_c"]
    cpu_t = th.get("cpu_max")
    gpu_t = th.get("gpu_max")
    skin_t = th.get("skin")
    if (cpu_t is not None and cpu_t >= 90.0) or (skin_t is not None and skin_t >= 52.0):
        add(
            "thermals",
            "SoC 与机身温控",
            "FAIL",
            f"高温告警 CPU={cpu_t}°C, GPU={gpu_t}°C, 机身={skin_t}°C",
            "建议切至 `salami-ctl perf eco` 并检查散热",
        )
    elif (cpu_t is not None and cpu_t >= 75.0) or (gpu_t is not None and gpu_t >= 75.0) or (skin_t is not None and skin_t >= 45.0):
        add(
            "thermals",
            "SoC 与机身温控",
            "WARN",
            f"温度偏高 CPU={cpu_t}°C, GPU={gpu_t}°C, 机身={skin_t}°C",
            "持续满载时可切至 `salami-ctl perf balanced` 或 `eco`",
        )
    else:
        add("thermals", "SoC 与机身温控", "PASS", f"CPU {cpu_t}°C · GPU {gpu_t}°C · 机身 {skin_t}°C")

    # 4. Display & Touch sync
    ref = get_refresh_status(paths)
    touch = status["touch"]
    dpms = status["display"]["dpms"]
    p_hz = ref["active_panel_hz"]
    t_hz = ref["active_touch_hz"]
    if p_hz is not None and t_hz is not None and p_hz != t_hz:
        add(
            "display_touch",
            "显示与触控同步",
            "WARN",
            f"面板 ({p_hz} Hz) 与触控 ({t_hz} Hz) 刷新率不一致",
            f"执行 `salami-ctl refresh {p_hz}` 同步双端刷新率",
        )
    elif dpms.lower() == "on" and touch.get("power_mode_supported") and touch.get("power_mode") != "active":
        add(
            "display_touch",
            "显示与触控同步",
            "WARN",
            f"屏幕已亮起 (DSI {dpms}) 但触控仍处于 {touch['power_mode']} 状态",
            "执行 `salami-ctl touch mode active` 恢复触控",
        )
    else:
        add(
            "display_touch",
            "显示与触控同步",
            "PASS",
            f"DSI {dpms} @ {p_hz or status['display']['refresh_hz']} Hz，触控 {touch['power_mode']} (息屏策略 {touch['off_policy']})",
        )

    # 5. GPU & Iris3 Hardware Video
    has_render = (paths.dri_dir / "renderD128").exists()
    has_iris_dec = (paths.dev_dir / "video0").exists()
    has_iris_enc = (paths.dev_dir / "video1").exists()
    has_va = (paths.va_driver_dir / "qcom_drv_video.so").exists() or (paths.va_driver_dir / "msm_drv_video.so").exists()
    if has_render and has_iris_dec and has_iris_enc and has_va:
        add("gpu_video", "GPU 与 Iris3 视频硬解", "PASS", "renderD128 + Iris3 (/dev/video0, video1) + VA-API 驱动就绪")
    elif has_render:
        missing = [
            lbl
            for ok_flag, lbl in (
                (has_iris_dec, "/dev/video0"),
                (has_iris_enc, "/dev/video1"),
                (has_va, "qcom_drv_video.so"),
            )
            if not ok_flag
        ]
        add(
            "gpu_video",
            "GPU 与 Iris3 视频硬解",
            "WARN",
            f"GPU 渲染节点可用，但缺少 Iris3 组件: {', '.join(missing)}",
            "确认已安装 qcom-va-driver 与导入 vendor_a Iris3 固件",
        )
    else:
        add(
            "gpu_video",
            "GPU 与 Iris3 视频硬解",
            "FAIL",
            "未检测到 /dev/dri/renderD128 硬件渲染节点",
            "检查 msm/adreno 驱动及 `salami-import-gpu-firmware.service`",
        )

    # 6. Storage (UFS 4.0 + Disk space) & ZRAM
    ufs_sched = status["storage"]["ufs_scheduler"]
    zram = status["memory"].get("zram") or {}
    root_du = _disk_usage_pct(paths.root_mount)
    home_du = _disk_usage_pct(paths.home_mount) if paths.home_mount != paths.root_mount else None
    disk_warns: list[str] = []
    disk_fails: list[str] = []
    disk_parts: list[str] = []
    for label, du in (("/", root_du), ("/home", home_du)):
        if du is None:
            continue
        pct, free_g, tot_g = du
        disk_parts.append(f"{label} {pct}% (余 {free_g}/{tot_g}G)")
        if pct >= 95.0:
            disk_fails.append(f"{label} 已用 {pct}%")
        elif pct >= 85.0:
            disk_warns.append(f"{label} 已用 {pct}%")
    if disk_fails:
        add(
            "storage_memory",
            "UFS 存储与 ZRAM 内存",
            "FAIL",
            f"磁盘空间告急: {', '.join(disk_fails)}",
            "清理大文件、日志 (`journalctl --vacuum-size=256M`) 或 apt 缓存",
        )
    elif disk_warns or ufs_sched != "none" or not zram:
        reasons = list(disk_warns)
        if ufs_sched != "none":
            reasons.append(f"UFS 调度器={ufs_sched}")
        if not zram:
            reasons.append("ZRAM 未启用")
        add(
            "storage_memory",
            "UFS 存储与 ZRAM 内存",
            "WARN",
            f"{' · '.join(reasons)} ({'，'.join(disk_parts)})",
            "运行 `systemctl start salami-ufs-tune.service` 或检查 zram0",
        )
    else:
        z_txt = f"ZRAM {zram.get('ratio', 1.0)}x"
        add("storage_memory", "UFS 存储与 ZRAM 内存", "PASS", f"UFS [{ufs_sched}] · {z_txt} · {'，'.join(disk_parts)}")

    # 7. Network & 5G Modem
    tcp_cc = status["network"]["tcp_congestion_control"]
    qdisc = status["network"]["default_qdisc"]
    has_regdb = paths.regdb_file.exists()
    net_issues: list[str] = []
    if tcp_cc != "bbr" or qdisc != "fq":
        net_issues.append(f"TCP={tcp_cc}+{qdisc}")
    if not has_regdb:
        net_issues.append("缺少 regulatory.db")
    if live:
        net_info = collect_net_and_services(paths)
        if net_info["wifi_wlp1s0"] and net_info["wifi_power_save"] not in ("off", "unknown"):
            net_issues.append(f"Wi-Fi power_save={net_info['wifi_power_save']}")
        mdm = net_info["modem"]
        if mdm.get("present") and mdm.get("sim_present") and mdm.get("power_state") == "on" and mdm.get("state") in ("searching", "registered") and not mdm.get("ip"):
            net_issues.append(f"5G 基带未分配 IP ({mdm['state']})")
    if net_issues:
        add(
            "network_modem",
            "网络栈与 5G 蜂窝",
            "WARN",
            "；".join(net_issues),
            "执行 `salami-ctl net` 或 `salami-ctl modem recover` 检查链路",
        )
    else:
        add("network_modem", "网络栈与 5G 蜂窝", "PASS", f"TCP {tcp_cc} + {qdisc}，wireless-regdb 就绪")

    # 8. Security & Firewall
    unmit = sec["cpu_unmitigated"]
    sys_ok = sec["sysctl_ok"]
    sys_tot = sec["sysctl_total"]
    nft_ok = sec["nftables_active"]
    if unmit or not nft_ok:
        reasons = []
        if unmit:
            reasons.append(f"CPU 未缓解项: {', '.join(unmit)}")
        if not nft_ok:
            reasons.append("nftables 防火墙未运行")
        add(
            "security",
            "安全加固与防火墙",
            "FAIL",
            "；".join(reasons),
            "执行 `salami-ctl security` 并检查 `nftables.service`",
        )
    elif sys_tot > 0 and sys_ok < sys_tot:
        add(
            "security",
            "安全加固与防火墙",
            "WARN",
            f"内核加固参数 {sys_ok}/{sys_tot} 生效，nftables 运行中",
            "执行 `sudo sysctl --system` 重新加载 60-salami-security.conf",
        )
    else:
        add(
            "security",
            "安全加固与防火墙",
            "PASS",
            f"CPU {len(sec['cpu_vulnerabilities'])} 项受保护 · sysctl {sys_ok}/{sys_tot} · nftables 运行中",
        )

    counts = {
        "pass": sum(1 for c in checks if c["status"] == "PASS"),
        "warn": sum(1 for c in checks if c["status"] == "WARN"),
        "fail": sum(1 for c in checks if c["status"] == "FAIL"),
    }
    overall = "FAIL" if counts["fail"] > 0 else ("WARN" if counts["warn"] > 0 else "PASS")
    return {"overall": overall, "counts": counts, "checks": checks}


def format_doctor_report(report: dict[str, Any]) -> str:
    cnt = report["counts"]
    lines = [
        f"=== OnePlus 11 (salami) 一键系统体检 [{report['overall']}] "
        f"(通过 {cnt['pass']} / 告警 {cnt['warn']} / 异常 {cnt['fail']}) ===",
    ]
    for item in report["checks"]:
        tag = f"[{item['status']:4s}]"
        lines.append(f"{tag} {item['name']}: {item['detail']}")
        if item["hint"]:
            lines.append(f"       -> 建议: {item['hint']}")
    return "\n".join(lines)


def render_watch_frame(
    status: dict[str, Any],
    peaks: dict[str, float],
    interval_s: float,
    elapsed_s: float,
) -> str:
    """Render one frame of the live terminal telemetry dashboard and update session peaks."""
    b = status["battery"]
    u = status["usb"]
    p = status["perf"]
    t = status["thermals_c"]
    d = status["display"]
    m = status["memory"]
    st = status["storage"]
    n = status["network"]

    pw = float(b.get("power_w") or 0.0)
    peaks["power_w"] = max(peaks.get("power_w", 0.0), pw)
    for k, val in (("cpu_max", t.get("cpu_max")), ("gpu_max", t.get("gpu_max")), ("skin", t.get("skin"))):
        if val is not None:
            peaks[k] = max(peaks.get(k, -999.0), float(val))

    clusters = p.get("clusters") or {}
    cpu_parts = []
    for cname, label in (("policy0", "A510"), ("policy3", "A715"), ("policy7", "X3")):
        cinfo = clusters.get(cname)
        if not cinfo:
            continue
        cur_s = f"{cinfo['cur_mhz']}/" if "cur_mhz" in cinfo else ""
        cpu_parts.append(f"{label} {cur_s}{cinfo['max_mhz']}MHz")
    gpu = p.get("gpu") or {}
    gpu_cur_s = f"{gpu['cur_mhz']}/" if "cur_mhz" in gpu else ""
    gpu_line = f"Adreno 740 {gpu_cur_s}{gpu.get('min_mhz', '?')}–{gpu.get('max_mhz', '?')}MHz" if gpu else "Adreno 740 -"

    rem_s = b.get("restore_timer_remaining_s")
    rem_note = f" | 倒计时 {format_duration_short(rem_s)}" if rem_s else ""
    pwr_verb = "放电" if b.get("status") == "Discharging" and pw >= 0.1 else "功率"
    zram = m.get("zram") or {}
    zram_s = f"{zram.get('compr_mib', 0)} MiB ({zram.get('ratio', 1.0)}x)" if zram else "未启用"
    usb_s = f"{u['voltage_v']:.2f}V / {u['current_a']:.2f}A" if u["online"] else "未接入"

    lines = [
        f"=== OnePlus 11 实时遥测看板 (每 {interval_s:g}s 刷新 · 已运行 {int(elapsed_s)}s · Ctrl+C 退出) ===",
        f"电池供电 : {b['capacity_pct']}% ({b['status']}) | {pwr_verb} {pw:.2f} W (峰值 {peaks['power_w']:.2f} W) | "
        f"{b['voltage_v']:.3f} V / {b['current_a']:.2f} A",
        f"快充限充 : USB {usb_s} | 限充 {b['start_threshold_pct']}–{b['end_threshold_pct']}%{rem_note} | "
        f"SUPERVOOC={'开' if b['vooc_enabled'] else '关'} (cool={b['vooc_cool_down']})",
        f"性能档位 : {p['label']} | Boost={'开' if p['boost'] else '关'}",
        f"实时频率 : {' | '.join(cpu_parts) or '-'} | {gpu_line}",
        f"温度峰值 : CPU {t['cpu_max']}°C (峰 {peaks.get('cpu_max', 0):.1f}°C) | "
        f"GPU {t['gpu_max']}°C (峰 {peaks.get('gpu_max', 0):.1f}°C) | "
        f"机身 {t['skin']}°C (峰 {peaks.get('skin', 0):.1f}°C) | 电池 {b['temp_c']}°C",
        f"屏幕内存 : DSI {d['dpms']} @ {d['refresh_hz']}Hz 亮度 {d['brightness_pct']}% | "
        f"RAM {m['ram_used_gib']}/{m['ram_total_gib']}G | ZRAM {zram_s} | "
        f"UFS [{st['ufs_scheduler']}] | {n['tcp_congestion_control']}+{n['default_qdisc']}",
    ]
    return "\n".join(lines)


def run_watch(
    interval_s: float = 1.0,
    *,
    count: int | None = None,
    paths: SysfsPaths = SysfsPaths(),
) -> int:
    if interval_s < 0.2 or interval_s > 60.0:
        raise ValueError("刷新间隔 --interval 须在 0.2..60 秒之间")
    peaks: dict[str, float] = {}
    start_ts = time.monotonic()
    is_tty = sys.stdout.isatty()
    shown = 0
    try:
        while True:
            frame = render_watch_frame(collect_status(paths), peaks, interval_s, time.monotonic() - start_ts)
            if is_tty:
                sys.stdout.write("\033[2J\033[H")
            sys.stdout.write(frame + "\n")
            sys.stdout.flush()
            shown += 1
            if count is not None and shown >= count:
                return 0
            select.select([], [], [], interval_s)
    except KeyboardInterrupt:
        return 0


