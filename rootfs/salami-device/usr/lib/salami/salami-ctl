def _default_grd_env_file() -> Path:
    return Path.home() / ".config/environment.d/60-salami-grd.conf"


def _read_str(path: Path, default: str = "") -> str:
    try:
        return path.read_text(encoding="utf-8", errors="ignore").strip()
    except OSError:
        return default


def _read_int(path: Path, default: int | None = None) -> int | None:
    raw = _read_str(path)
    if not raw:
        return default
    try:
        return int(raw)
    except ValueError:
        return default


def detect_perf_profile(paths: SysfsPaths = SysfsPaths()) -> dict[str, Any]:
    clusters: dict[str, dict[str, Any]] = {}
    govs: list[str] = []
    capped = False
    if paths.cpufreq_dir.is_dir():
        for pol in sorted(paths.cpufreq_dir.glob("policy*")):
            gov = _read_str(pol / "scaling_governor", "unknown")
            cur_max = _read_int(pol / "scaling_max_freq", 0) or 0
            hw_max = _read_int(pol / "cpuinfo_max_freq", cur_max) or cur_max
            govs.append(gov)
            if hw_max > 0 and cur_max < hw_max:
                capped = True
            clusters[pol.name] = {
                "governor": gov,
                "max_mhz": round(cur_max / 1000),
                "hw_max_mhz": round(hw_max / 1000),
            }
    gpu_min = _read_int(paths.gpu_devfreq_dir / "min_freq")
    gpu_max = _read_int(paths.gpu_devfreq_dir / "max_freq")
    gpu_info = (
        {"min_mhz": round(gpu_min / 1_000_000), "max_mhz": round(gpu_max / 1_000_000)}
        if gpu_min is not None and gpu_max is not None
        else None
    )
    boost_on = _read_int(paths.cpufreq_boost, 0) == 1
    if govs and all(g == "performance" for g in govs) and not capped:
        mode = "performance"
    elif capped:
        mode = "eco"
    else:
        mode = "balanced"
    return {
        "mode": mode,
        "label": PERF_LABELS[mode],
        "boost": boost_on,
        "clusters": clusters,
        "gpu": gpu_info,
    }


def set_perf_profile(mode: str, paths: SysfsPaths = SysfsPaths()) -> dict[str, Any]:
    mode = mode.lower()
    if mode not in ("eco", "balanced", "performance"):
        raise ValueError("性能模式须为 eco | balanced | performance")
    if not paths.cpufreq_dir.is_dir():
        raise FileNotFoundError("未找到 cpufreq 调频目录")
    policies = sorted(paths.cpufreq_dir.glob("policy*"))
    if not policies:
        raise FileNotFoundError("未找到任何 cpufreq policy 节点")

    # Unlock Cortex-X3 3.187 GHz boost OPP before reading cpuinfo_max_freq in performance mode.
    if paths.cpufreq_boost.is_file():
        paths.cpufreq_boost.write_text("1\n" if mode == "performance" else "0\n", encoding="utf-8")

    target_gov = "performance" if mode == "performance" else "schedutil"
    for pol in policies:
        hw_max = _read_int(pol / "cpuinfo_max_freq")
        if hw_max is None:
            continue
        if mode == "performance":
            boost_freqs = [int(x) for x in _read_str(pol / "scaling_boost_frequencies").split() if x.isdigit()]
            if boost_freqs:
                hw_max = max(hw_max, max(boost_freqs))
        target_max = min(hw_max, ECO_MAX_KHZ.get(pol.name, hw_max)) if mode == "eco" else hw_max
        (pol / "scaling_max_freq").write_text(f"{target_max}\n", encoding="utf-8")
        (pol / "scaling_governor").write_text(f"{target_gov}\n", encoding="utf-8")

    # Coordinate Adreno 740 GPU devfreq safely keeping min_freq <= max_freq at every write.
    gpu_min_p = paths.gpu_devfreq_dir / "min_freq"
    gpu_max_p = paths.gpu_devfreq_dir / "max_freq"
    if gpu_min_p.is_file() and gpu_max_p.is_file():
        target_gmin, target_gmax = GPU_PROFILE_HZ[mode]
        cur_gmax = _read_int(gpu_max_p, 680_000_000) or 680_000_000
        if target_gmin > cur_gmax:
            gpu_max_p.write_text(f"{target_gmax}\n", encoding="utf-8")
            gpu_min_p.write_text(f"{target_gmin}\n", encoding="utf-8")
        elif target_gmax < (_read_int(gpu_min_p, 220_000_000) or 220_000_000):
            gpu_min_p.write_text(f"{target_gmin}\n", encoding="utf-8")
            gpu_max_p.write_text(f"{target_gmax}\n", encoding="utf-8")
        else:
            gpu_max_p.write_text(f"{target_gmax}\n", encoding="utf-8")
            gpu_min_p.write_text(f"{target_gmin}\n", encoding="utf-8")

    return detect_perf_profile(paths)


def get_refresh_status(paths: SysfsPaths = SysfsPaths()) -> dict[str, int | None]:
    active_panel = _read_int(paths.panel_refresh_param)
    active_touch = _read_int(paths.touch_refresh_param)
    configured: int | None = None
    if paths.refresh_modprobe_conf.is_file():
        m = re.search(
            r"^\s*options\s+panel_samsung_amb670yf07(?:_iris7)?\s+refresh=([0-9]+)\s*$",
            _read_str(paths.refresh_modprobe_conf),
            re.M,
        )
        if m:
            configured = int(m.group(1))
    return {
        "active_panel_hz": active_panel,
        "active_touch_hz": active_touch,
        "configured_hz": configured,
    }


def set_refresh_rate(hz: int, paths: SysfsPaths = SysfsPaths()) -> dict[str, Any]:
    if hz not in VALID_REFRESH_HZ:
        raise ValueError("刷新率仅支持 60 | 90 | 120 Hz")
    runtime_panel = False
    runtime_touch = False
    for param_path, tag in ((paths.touch_refresh_param, "touch"), (paths.panel_refresh_param, "panel")):
        if param_path.is_file() and os.access(param_path, os.W_OK):
            try:
                param_path.write_text(f"{hz}\n", encoding="utf-8")
                if tag == "touch":
                    runtime_touch = True
                else:
                    runtime_panel = True
            except OSError:
                pass

    if paths.refresh_modprobe_conf.parent.exists() and os.access(paths.refresh_modprobe_conf.parent, os.W_OK):
        content = (
            "# Keep panel and touchscreen refresh rates strictly synchronized (60, 90, or 120 Hz).\n"
            "# Managed via `salami-ctl refresh <60|90|120>`.\n"
            f"options panel_samsung_amb670yf07_iris7 refresh={hz}\n"
            f"options synaptics_tcm_i2c refresh={hz}\n"
        )
        tmp_path = paths.refresh_modprobe_conf.with_suffix(".conf.tmp")
        tmp_path.write_text(content, encoding="utf-8")
        os.chmod(tmp_path, 0o644)
        tmp_path.replace(paths.refresh_modprobe_conf)
    elif not paths.refresh_modprobe_conf.parent.exists():
        paths.refresh_modprobe_conf.parent.mkdir(parents=True, exist_ok=True)
        content = (
            "# Keep panel and touchscreen refresh rates strictly synchronized (60, 90, or 120 Hz).\n"
            "# Managed via `salami-ctl refresh <60|90|120>`.\n"
            f"options panel_samsung_amb670yf07_iris7 refresh={hz}\n"
            f"options synaptics_tcm_i2c refresh={hz}\n"
        )
        paths.refresh_modprobe_conf.write_text(content, encoding="utf-8")

    st: dict[str, Any] = dict(get_refresh_status(paths))
    st["runtime_panel_applied"] = runtime_panel
    st["runtime_touch_applied"] = runtime_touch
    return st


def get_hbm_state(paths: SysfsPaths = SysfsPaths()) -> tuple[bool, bool]:
    """Return (supported, enabled)."""
    if not paths.panel_hbm_param.is_file():
        return False, False
    val = _read_str(paths.panel_hbm_param).upper()
    return True, val in ("Y", "1", "TRUE")


def set_hbm_state(action: str, paths: SysfsPaths = SysfsPaths()) -> bool:
    action = action.lower()
    if action not in ("status", "on", "off", "toggle"):
        raise ValueError("阳光屏参数须为 status | on | off | toggle")
    supported, cur = get_hbm_state(paths)
    if action == "status":
        return cur
    if not supported:
        raise FileNotFoundError("当前运行中的面板模块尚未加载 HBM 参数（重启加载新模块后生效）")
    target = True if action == "on" else (False if action == "off" else not cur)
    paths.panel_hbm_param.write_text("1\n" if target else "0\n", encoding="utf-8")
    return get_hbm_state(paths)[1]


def get_vooc_status(paths: SysfsPaths = SysfsPaths()) -> dict[str, Any]:
    supported = paths.vooc_param.is_file()
    enabled = _read_str(paths.vooc_param).upper() in ("Y", "1", "TRUE")
    cool_down = _read_int(paths.vooc_cool_param, 0) or 0
    configured: bool | None = None
    if paths.vooc_modprobe_conf.is_file():
        m = re.search(r"\bvooc=([01yYnN])\b", _read_str(paths.vooc_modprobe_conf))
        if m:
            configured = m.group(1).upper() in ("1", "Y")
    return {
        "supported": supported,
        "enabled": enabled,
        "cool_down": cool_down,
        "configured": configured,
    }


def set_vooc_state(
    action: str,
    *,
    cool_down: int | None = None,
    persist: bool = False,
    paths: SysfsPaths = SysfsPaths(),
) -> dict[str, Any]:
    action = action.lower()
    if action not in ("status", "on", "off", "toggle"):
        raise ValueError("闪充参数须为 status | on | off | toggle")
    st = get_vooc_status(paths)
    if action != "status":
        if not st["supported"]:
            raise FileNotFoundError("未找到 qcom_battmgr SUPERVOOC 参数节点")
        target = True if action == "on" else (False if action == "off" else not st["enabled"])
        paths.vooc_param.write_text("1\n" if target else "0\n", encoding="utf-8")
        if persist:
            paths.vooc_modprobe_conf.parent.mkdir(parents=True, exist_ok=True)
            content = (
                "# OnePlus 11 (salami) SUPERVOOC fast-charging policy.\n"
                f"options qcom_battmgr vooc={1 if target else 0}\n"
            )
            tmp = paths.vooc_modprobe_conf.with_suffix(".conf.tmp")
            tmp.write_text(content, encoding="utf-8")
            os.chmod(tmp, 0o644)
            tmp.replace(paths.vooc_modprobe_conf)
    if cool_down is not None:
        if not 0 <= cool_down <= 32:
            raise ValueError("SUPERVOOC 限流档位须在 0..32 之间（0=全速满功率）")
        if not paths.vooc_cool_param.is_file():
            raise FileNotFoundError("未找到 vooc_cool_down 参数节点")
        paths.vooc_cool_param.write_text(f"{cool_down}\n", encoding="utf-8")
    return get_vooc_status(paths)


def get_touch_status(paths: SysfsPaths = SysfsPaths()) -> dict[str, Any]:
    glove_sup = paths.touch_glove_param.is_file()
    glove_on = _read_str(paths.touch_glove_param).upper() in ("Y", "1", "TRUE") if glove_sup else False
    pm_sup = paths.touch_power_mode_param.is_file()
    pm_val = _read_str(paths.touch_power_mode_param, "active").lower() if pm_sup else "active"
    raw_pol = _read_str(paths.touch_off_policy_file, "gesture").lower()
    off_policy = raw_pol if raw_pol in TOUCH_OFF_LABELS else "gesture"
    return {
        "glove_supported": glove_sup,
        "glove_enabled": glove_on,
        "power_mode_supported": pm_sup,
        "power_mode": pm_val,
        "off_policy": off_policy,
        "off_policy_label": TOUCH_OFF_LABELS[off_policy],
    }


def set_touch_glove(action: str, paths: SysfsPaths = SysfsPaths()) -> bool:
    action = action.lower()
    if action not in ("status", "on", "off", "toggle"):
        raise ValueError("手套触控参数须为 status | on | off | toggle")
    st = get_touch_status(paths)
    if action == "status":
        return st["glove_enabled"]
    if not st["glove_supported"]:
        raise FileNotFoundError("当前触控模块尚未加载 glove 参数")
    target = True if action == "on" else (False if action == "off" else not st["glove_enabled"])
    paths.touch_glove_param.write_text("1\n" if target else "0\n", encoding="utf-8")
    return get_touch_status(paths)["glove_enabled"]


def set_touch_power_mode(mode: str, paths: SysfsPaths = SysfsPaths()) -> str:
    mode = mode.lower()
    if mode not in TOUCH_OFF_LABELS:
        raise ValueError("触控运行状态须为 active | gesture | sleep")
    if not paths.touch_power_mode_param.is_file():
        raise FileNotFoundError("当前触控模块尚未加载 power_mode 参数")
    paths.touch_power_mode_param.write_text(f"{mode}\n", encoding="utf-8")
    return _read_str(paths.touch_power_mode_param, mode).lower()


def set_touch_off_policy(policy: str, paths: SysfsPaths = SysfsPaths()) -> dict[str, Any]:
    policy = policy.lower()
    if policy not in TOUCH_OFF_LABELS:
        raise ValueError("息屏触控策略须为 gesture | sleep | active")
    paths.touch_off_policy_file.parent.mkdir(parents=True, exist_ok=True)
    paths.touch_off_policy_file.write_text(f"{policy}\n", encoding="utf-8")
    if get_screen_dpms(paths).lower() == "off" and paths.touch_power_mode_param.is_file():
        try:
            paths.touch_power_mode_param.write_text(f"{policy}\n", encoding="utf-8")
        except OSError:
            pass
    return get_touch_status(paths)


def get_screen_dpms(paths: SysfsPaths = SysfsPaths()) -> str:
    if paths.drm_dir.is_dir():
        for dsi in sorted(paths.drm_dir.glob("card*-DSI-1/dpms")):
            return _read_str(dsi, "Unknown")
    return "Unknown"


def control_physical_screen(action: str, paths: SysfsPaths = SysfsPaths()) -> str:
    action = action.lower()
    if action not in ("status", "on", "off", "toggle"):
        raise ValueError("屏幕操作须为 status | on | off | toggle")
    if action == "status":
        return get_screen_dpms(paths)

    spec = importlib.util.spec_from_loader(
        "salami_power_key_mod",
        SourceFileLoader("salami_power_key_mod", str(paths.power_key_script)),
    )
    assert spec is not None and spec.loader is not None
    pk = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(pk)

    wake_dev = pk.UInputWakeDevice()
    touch_sync = (
        pk.TouchPolicySync(
            power_mode_param=paths.touch_power_mode_param,
            off_policy_file=paths.touch_off_policy_file,
            drm_dir=paths.drm_dir,
        )
        if hasattr(pk, "TouchPolicySync")
        else None
    )
    backend = (
        pk.Seat0GnomeBackend(wake_emitter=wake_dev, touch_sync=touch_sync)
        if touch_sync is not None
        else pk.Seat0GnomeBackend(wake_emitter=wake_dev)
    )
    try:
        currently_off = backend.is_screen_off() or get_screen_dpms(paths).lower() != "on"
        want_on = True if action == "on" else (False if action == "off" else currently_off)
        if want_on:
            wake_dev.open()
            backend.wake_screen()
        else:
            backend.blank_screen()
    finally:
        wake_dev.close()
    select.select([], [], [], 0.15)
    return get_screen_dpms(paths)


def get_rdp_qp(paths: SysfsPaths = SysfsPaths()) -> int:
    env_file = paths.grd_env_file or _default_grd_env_file()
    if env_file.is_file():
        m = re.search(r"^\s*GRD_VAAPI_QP\s*=\s*([0-9]+)\s*$", _read_str(env_file), re.M)
        if m:
            val = int(m.group(1))
            if 1 <= val <= 51:
                return val
    return 22


def set_rdp_qp(spec: str, paths: SysfsPaths = SysfsPaths()) -> tuple[int, str]:
    key = spec.lower()
    if key in RDP_PRESETS:
        qp, desc = RDP_PRESETS[key]
    else:
        qp = int(spec)
        if not 1 <= qp <= 51:
            raise ValueError("RDP VA-API QP 须为 hq | balanced | fast 或 1..51 整数")
        desc = f"自定义 QP={qp}"

    env_file = paths.grd_env_file or _default_grd_env_file()
    env_file.parent.mkdir(parents=True, exist_ok=True)
    env_file.write_text(f"GRD_VAAPI_QP={qp}\n", encoding="utf-8")

    if paths.grd_env_file is None and os.geteuid() != 0:
        subprocess.run(
            ["systemctl", "--user", "set-environment", f"GRD_VAAPI_QP={qp}"],
            capture_output=True,
            text=True,
        )
    return qp, desc


def collect_status(paths: SysfsPaths = SysfsPaths()) -> dict[str, Any]:
    bat_cap = _read_int(paths.bat_dir / "capacity")
    bat_status = _read_str(paths.bat_dir / "status", "Unknown")
    bat_v_uv = _read_int(paths.bat_dir / "voltage_now", 0) or 0
    bat_i_ua = _read_int(paths.bat_dir / "current_now", 0) or 0
    bat_p_uw = _read_int(paths.bat_dir / "power_now")
    if bat_p_uw is None:
        bat_p_uw = abs(bat_v_uv * bat_i_ua) // 1_000_000
    bat_temp_deci = _read_int(paths.bat_dir / "temp")
    start_thr = _read_int(paths.bat_dir / "charge_control_start_threshold")
    end_thr = _read_int(paths.bat_dir / "charge_control_end_threshold")
    cycles = _read_int(paths.bat_dir / "cycle_count")
    soh = _read_int(paths.bat_dir / "state_of_health")

    usb_online = _read_int(paths.usb_dir / "online", 0) == 1
    usb_v_uv = _read_int(paths.usb_dir / "voltage_now", 0) or 0
    usb_i_ua = _read_int(paths.usb_dir / "current_now", 0) or 0

    vooc_raw = _read_str(paths.vooc_param).upper()
    vooc_enabled = vooc_raw in ("Y", "1", "TRUE")
    vooc_cool = _read_int(paths.vooc_cool_param, 0)

    cpu_temps: list[float] = []
    gpu_temps: list[float] = []
    named_temps: dict[str, float] = {}
    if paths.thermal_dir.is_dir():
        for tz in sorted(paths.thermal_dir.glob("thermal_zone*")):
            t_type = _read_str(tz / "type")
            t_milli = _read_int(tz / "temp")
            if not t_type or t_milli is None:
                continue
            c = round(t_milli / 1000.0, 1)
            if t_type.startswith("cpu"):
                cpu_temps.append(c)
            elif t_type.startswith("gpuss"):
                gpu_temps.append(c)
            elif t_type in ("skin-msm-thermal", "video-thermal", "pm8550b-thermal", "xo-thermal"):
                named_temps[t_type] = c

    bl_cur = _read_int(paths.backlight_dir / "brightness", 0) or 0
    bl_max = _read_int(paths.backlight_dir / "max_brightness", 2047) or 2047
    bl_pct = round(bl_cur * 100.0 / bl_max) if bl_max > 0 else 0

    dpms = get_screen_dpms(paths)
    ref_info = get_refresh_status(paths)
    refresh_hz = ref_info["active_panel_hz"] or ref_info["configured_hz"] or 120

    torch_cur = _read_int(paths.torch_dir / "brightness", 0) or 0
    torch_max = _read_int(paths.torch_dir / "max_brightness", 255) or 255

    zram_info: dict[str, Any] = {}
    mm_raw = _read_str(paths.zram_mm_stat).split()
    if len(mm_raw) >= 3:
        try:
            orig_b = int(mm_raw[0])
            compr_b = int(mm_raw[1])
            zram_info = {
                "orig_mib": round(orig_b / 1048576.0, 1),
                "compr_mib": round(compr_b / 1048576.0, 1),
                "ratio": round(orig_b / compr_b, 2) if compr_b > 0 else 1.0,
            }
        except ValueError:
            pass

    mem_total_kib = 0
    mem_avail_kib = 0
    if paths.proc_meminfo.is_file():
        for line in _read_str(paths.proc_meminfo).splitlines():
            if line.startswith("MemTotal:"):
                mem_total_kib = int(line.split()[1])
            elif line.startswith("MemAvailable:"):
                mem_avail_kib = int(line.split()[1])

    sched_raw = _read_str(paths.ufs_queue_dir / "scheduler")
    m_sched = re.search(r"\[([^\]]+)\]", sched_raw)
    ufs_sched = m_sched.group(1) if m_sched else (sched_raw or "unknown")
    ufs_ra = _read_int(paths.ufs_queue_dir / "read_ahead_kb")

    perf = detect_perf_profile(paths)

    return {
        "battery": {
            "capacity_pct": bat_cap,
            "status": bat_status,
            "power_w": round(bat_p_uw / 1_000_000.0, 2),
            "voltage_v": round(bat_v_uv / 1_000_000.0, 3),
            "current_a": round(bat_i_ua / 1_000_000.0, 3),
            "temp_c": round(bat_temp_deci / 10.0, 1) if bat_temp_deci is not None else None,
            "start_threshold_pct": start_thr,
            "end_threshold_pct": end_thr,
            "cycle_count": cycles,
            "state_of_health_pct": soh,
            "vooc_enabled": vooc_enabled,
            "vooc_cool_down": vooc_cool,
        },
        "usb": {
            "online": usb_online,
            "voltage_v": round(usb_v_uv / 1_000_000.0, 2),
            "current_a": round(usb_i_ua / 1_000_000.0, 3),
        },
        "perf": perf,
        "rdp_vaapi_qp": get_rdp_qp(paths),
        "thermals_c": {
            "cpu_max": max(cpu_temps) if cpu_temps else None,
            "cpu_avg": round(sum(cpu_temps) / len(cpu_temps), 1) if cpu_temps else None,
            "gpu_max": max(gpu_temps) if gpu_temps else None,
            "skin": named_temps.get("skin-msm-thermal"),
            "iris_video": named_temps.get("video-thermal"),
            "pm8550b": named_temps.get("pm8550b-thermal"),
        },
        "display": {
            "dpms": dpms,
            "brightness": bl_cur,
            "max_brightness": bl_max,
            "brightness_pct": bl_pct,
            "hbm_supported": get_hbm_state(paths)[0],
            "hbm_enabled": get_hbm_state(paths)[1],
            "refresh_hz": refresh_hz,
            "configured_refresh_hz": ref_info["configured_hz"],
        },
        "touch": get_touch_status(paths),
        "torch": {
            "brightness": torch_cur,
            "max_brightness": torch_max,
            "active": torch_cur > 0,
        },
        "storage": {
            "ufs_scheduler": ufs_sched,
            "read_ahead_kb": ufs_ra,
        },
        "memory": {
            "ram_used_gib": round((mem_total_kib - mem_avail_kib) / 1048576.0, 2) if mem_total_kib else None,
            "ram_total_gib": round(mem_total_kib / 1048576.0, 2) if mem_total_kib else None,
            "zram": zram_info,
        },
        "network": {
            "tcp_congestion_control": _read_str(paths.proc_tcp_cc, "unknown"),
            "default_qdisc": _read_str(paths.proc_qdisc, "unknown"),
        },
    }


