def build_privileged_command(argv: list[str]) -> list[str]:
    if os.geteuid() == 0:
        return argv
    sudo_ok = subprocess.run(
        ["/usr/bin/sudo", "-n", "true"], capture_output=True
    ).returncode == 0
    if sudo_ok:
        return ["/usr/bin/sudo", "-n", *argv]
    if Path("/usr/bin/pkexec").is_file() and (
        os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    ):
        return ["/usr/bin/pkexec", *argv]
    return ["/usr/bin/sudo", *argv]


def _reexec_with_sudo(sub_args: list[str]) -> int:
    cmd = build_privileged_command([str(Path(__file__).resolve()), *sub_args])
    res = subprocess.run(cmd)
    return res.returncode


def main(argv: list[str] | None = None, paths: SysfsPaths = SysfsPaths()) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    cmd = args.command or "status"

    try:
        if cmd == "status":
            data = collect_status(paths)
            if getattr(args, "json", False):
                print(json.dumps(data, ensure_ascii=False, indent=2))
            else:
                print(format_status(data))
            return 0

        if cmd == "watch":
            return run_watch(args.interval, count=args.count, paths=paths)

        if cmd == "doctor":
            report = collect_doctor_report(paths)
            if getattr(args, "json", False):
                print(json.dumps(report, ensure_ascii=False, indent=2))
            else:
                print(format_doctor_report(report))
            return 1 if report["counts"]["fail"] > 0 else 0

        if cmd == "perf":
            info = detect_perf_profile(paths) if args.mode == "status" else set_perf_profile(args.mode, paths)
            details = ", ".join(
                f"{k}:{v['governor']} " + (f"{v['cur_mhz']}/" if "cur_mhz" in v else "") + f"≤{v['max_mhz']}MHz"
                for k, v in info["clusters"].items()
            )
            gpu_str = ""
            if info.get("gpu"):
                g = info["gpu"]
                gcur = f"{g['cur_mhz']}/" if "cur_mhz" in g else ""
                gpu_str = f", GPU:{gcur}{g['min_mhz']}–{g['max_mhz']}MHz"
            print(f"性能模式: {info['label']} ({details}{gpu_str})")
            return 0

        if cmd == "screen":
            if args.action == "status":
                print(f"手机物理 AMOLED 屏幕状态: DSI {get_screen_dpms(paths)}")
                return 0
            if os.geteuid() != 0 and paths.drm_dir == SysfsPaths.drm_dir:
                return _reexec_with_sudo(["screen", args.action])
            state = control_physical_screen(args.action, paths)
            print(f"手机物理 AMOLED 屏幕已切为: DSI {state}")
            return 0

        if cmd == "refresh":
            if args.hz == "status":
                st = get_refresh_status(paths)
                print(
                    f"当前运行刷新率: 面板={st['active_panel_hz']} Hz, 触控={st['active_touch_hz']} Hz | "
                    f"持久化配置={st['configured_hz']} Hz"
                )
                return 0
            hz = int(args.hz.lower().rstrip("hz"))
            if hz not in VALID_REFRESH_HZ:
                raise ValueError("刷新率仅支持 60 | 90 | 120 Hz")
            persist = not getattr(args, "no_persist", False)
            if persist and os.geteuid() != 0 and paths.refresh_modprobe_conf == SysfsPaths.refresh_modprobe_conf:
                return _reexec_with_sudo(["refresh", str(hz)])
            st = set_refresh_rate(hz, paths, persist=persist)
            live_note = (
                "面板与触控已实时切换"
                if st["runtime_panel_applied"] and st["runtime_touch_applied"]
                else ("触控已实时切换，面板将在下次重启或亮屏切换生效" if st["runtime_touch_applied"] else "将在下次重启模块加载生效")
            )
            persist_note = "" if st.get("persisted") else "，未持久化"
            print(
                f"刷新率已同步设为 {hz} Hz（{live_note}{persist_note}，"
                f"当前运行面板={st['active_panel_hz']}Hz/触控={st['active_touch_hz']}Hz）"
            )
            return 0

        if cmd == "hbm":
            supported, active = get_hbm_state(paths)
            if args.action == "status":
                print(f"阳光屏超亮模式 (HBM): {'开启' if active else ('关闭' if supported else '待重启加载新面板模块后可用')}")
                return 0
            state = set_hbm_state(args.action, paths)
            print(f"阳光屏超亮模式 (HBM): {'已开启' if state else '已关闭'}")
            return 0

        if cmd == "vooc":
            if args.persist and os.geteuid() != 0 and paths.vooc_modprobe_conf == SysfsPaths.vooc_modprobe_conf:
                sub_cmd = ["vooc", args.action, "--persist"]
                if args.cool is not None:
                    sub_cmd.extend(["--cool", str(args.cool)])
                return _reexec_with_sudo(sub_cmd)
            st = set_vooc_state(args.action, cool_down=args.cool, persist=args.persist, paths=paths)
            mode_desc = "⚡ SUPERVOOC 50W 闪充允许" if st["enabled"] else "🌙 10W 低温慢充护航 (闪充已关)"
            print(f"快充协议状态: {mode_desc} | 限流档位 cool_down={st['cool_down']}")
            return 0

        if cmd == "touch":
            sc = args.subcmd.lower()
            if sc == "status":
                st = get_touch_status(paths)
                print(
                    f"触控状态: 当前={st['power_mode']} | 息屏策略={st['off_policy']} ({st['off_policy_label']}) | "
                    f"手套高敏={'开启' if st['glove_enabled'] else '关闭'}"
                )
                return 0
            if sc == "glove":
                on = set_touch_glove(args.value, paths)
                print(f"手套 / 湿手高灵敏触控: {'已开启' if on else '已关闭'}")
                return 0
            if sc == "mode":
                cur = set_touch_power_mode(args.value, paths)
                print(f"触控芯片实时状态已切为: {cur}")
                return 0
            if sc == "off-policy":
                st = set_touch_off_policy(args.value, paths)
                print(f"息屏触控策略已设为: {st['off_policy_label']}")
                return 0
            raise ValueError("touch 子命令须为 status | glove | mode | off-policy")

        if cmd == "modem":
            act = args.action.lower()
            if act == "status":
                st = collect_modem_status()
                if getattr(args, "json", False):
                    print(json.dumps(st, ensure_ascii=False, indent=2))
                else:
                    carrier = st["operator_name"] or st["operator_code"] or "未知运营商"
                    sig = f"{st['signal_pct']}%" if st["signal_pct"] is not None else "?"
                    print(
                        f"5G 基带: 状态={st['state']} (注册={st['registration']}) | 运营商={carrier} | "
                        f"制式={st['access_tech'] or '-'} | 信号={sig} | IP={st['ip'] or '未分配'}"
                    )
                return 0
            if act == "recover":
                if os.geteuid() != 0 and paths.modem_guard_state == SysfsPaths.modem_guard_state:
                    return _reexec_with_sudo(["modem", "recover"])
                st = recover_modem()
                print(
                    f"5G 基带自愈完成: 状态={st['state']} | 制式={st['access_tech'] or '-'} | IP={st['ip'] or '重连中'}"
                )
                return 0
            if act == "guard":
                res = guard_modem(paths)
                if getattr(args, "json", False):
                    print(json.dumps(res, ensure_ascii=False, indent=2))
                else:
                    print(f"modem-guard: {res['action']} (state={res['modem']['state']})")
                return 0
            raise ValueError("modem 参数须为 status | recover | guard")

        if cmd == "security":
            if os.geteuid() != 0 and paths.proc_sys_dir == SysfsPaths.proc_sys_dir:
                extra = ["--json"] if getattr(args, "json", False) else []
                return _reexec_with_sudo(["security", *extra])
            sec = collect_security_status(paths)
            if getattr(args, "json", False):
                print(json.dumps(sec, ensure_ascii=False, indent=2))
            else:
                print(format_security_status(sec))
            return 0

        if cmd == "service":
            allowed = {u: (lbl, act) for u, lbl, act in discover_managed_services(paths)}
            unit = args.unit if args.unit.endswith(".service") else f"{args.unit}.service"
            if unit not in allowed:
                raise ValueError(f"未授权或未启用的服务单元: {unit}")
            lbl, default_act = allowed[unit]
            req_act = args.action.lower() if args.action else default_act
            if req_act not in ("start", "stop", "restart", "reload"):
                raise ValueError("服务动作须为 start | stop | restart | reload")
            if os.geteuid() != 0 and paths.services_conf == SysfsPaths.services_conf:
                return _reexec_with_sudo(["service", unit, req_act])
            subprocess.run(["/usr/bin/systemctl", req_act, unit], check=True)
            verb_zh = {"start": "启动", "stop": "停止", "restart": "重启", "reload": "重载"}[req_act]
            print(f"{lbl} 已完成{verb_zh}")
            return 0

        if cmd == "fstrim":
            if os.geteuid() != 0:
                return _reexec_with_sudo(["fstrim"])
            out = subprocess.check_output(["/usr/sbin/fstrim", "-av"], text=True).strip()
            print(out or "UFS 闪存 TRIM 已完成")
            return 0

        if cmd == "rdp":
            if args.preset == "status":
                qp = get_rdp_qp(paths)
                print(f"远程桌面 Iris3 H.264 硬编 QP={qp}（默认 22，越小越清晰、越大越省带宽）")
                return 0
            qp, desc = set_rdp_qp(args.preset, paths)
            print(f"远程桌面硬编已设为 {desc}（下次重连 RDP 即生效）")
            return 0

        if cmd == "net":
            info = collect_net_and_services(paths)
            if getattr(args, "json", False):
                print(json.dumps(info, ensure_ascii=False, indent=2))
            else:
                print(format_net_and_services(info))
            return 0

        if cmd == "charge":
            if args.target == "status":
                b = collect_status(paths)["battery"]
                rem = format_duration_short(b.get("restore_timer_remaining_s"))
                rem_part = f"，{rem} 后恢复 80%" if rem else ""
                print(
                    f"当前电量 {b['capacity_pct']}% ({b['status']})，限充区间 "
                    f"{b['start_threshold_pct']}–{b['end_threshold_pct']}%{rem_part}，实时功率 {b['power_w']:.2f} W"
                )
                return 0
            limit = int(args.target.rstrip("%"))
            start, end = set_charge_limit(limit, paths)
            msg = f"充电上限已设为 {start}–{end}%"
            timer_note = _manage_restore_timer(
                args.hours if end > 80 else None,
                str(Path(__file__).resolve()),
            ) if paths.bat_dir == SysfsPaths.bat_dir else None
            print(f"{msg}（{timer_note}）" if timer_note else msg)
            return 0

        if cmd == "torch":
            val = set_torch(args.action, args.level, paths)
            print(f"手电筒: {'开启 (亮度 ' + str(val) + ')' if val > 0 else '关闭'}")
            return 0

        if cmd == "brightness":
            raw, pct = set_brightness(args.value, paths)
            print(f"AMOLED 屏幕亮度: {pct}% ({raw})")
            return 0

        if cmd == "vibrate":
            trigger_vibrate(args.ms, paths)
            print(f"已触发 {args.ms} ms 线性马达反馈")
            return 0

        parser.print_help()
        return 2
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"salami-ctl: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
