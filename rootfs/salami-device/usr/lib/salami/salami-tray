def format_indicator_label(status: dict[str, Any]) -> str:
    bat = status.get("battery") or {}
    therm = status.get("thermals_c") or {}
    perf = (status.get("perf") or {}).get("mode", "balanced")

    cap = bat.get("capacity_pct")
    watts = bat.get("power_w") or 0.0
    bat_state = bat.get("status", "")
    cpu_t = therm.get("cpu_max")

    badge = ""
    if perf == "performance":
        badge = "🚀 "
    elif perf == "eco":
        badge = "🌿 "

    if watts >= 0.8 and bat_state == "Charging":
        power_part = f"⚡{watts:.0f}W"
    elif cap is not None:
        power_part = f"{cap}%"
    else:
        power_part = "salami"

    temp_part = f" · {cpu_t:.0f}°C" if cpu_t is not None else ""
    return f" {badge}{power_part}{temp_part}"


def choose_indicator_icon(status: dict[str, Any]) -> str:
    bat = status.get("battery") or {}
    perf = (status.get("perf") or {}).get("mode", "balanced")
    watts = bat.get("power_w") or 0.0
    if watts >= 5.0 and bat.get("status") == "Charging":
        return "battery-good-charging-symbolic"
    if perf == "performance":
        return "power-profile-performance-symbolic"
    if perf == "eco":
        return "power-profile-power-saver-symbolic"
    return "phone-symbolic"


def nearest_preset(value: int, presets: tuple[tuple[int, str], ...]) -> int:
    return min(presets, key=lambda item: abs(item[0] - value))[0]


def format_summary_lines(status: dict[str, Any], net_info: dict[str, Any] | None = None) -> tuple[str, str, str, str]:
    b = status["battery"]
    t = status["thermals_c"]
    m = status["memory"]
    st = status["storage"]
    n = status["network"]

    watts = b.get("power_w") or 0.0
    w_str = f"{watts:.1f} W" if watts >= 0.1 else "0 W (稳压保持)"
    line_bat = (
        f"电池: {b.get('capacity_pct', '?')}% ({b.get('start_threshold_pct', '?')}–{b.get('end_threshold_pct', '?')}% 限充) "
        f"· {w_str} · {b.get('temp_c', '?')} °C"
    )
    line_temp = (
        f"温度: CPU {t.get('cpu_max', '?')} °C · GPU {t.get('gpu_max', '?')} °C · 机身 {t.get('skin', '?')} °C"
    )
    zram = m.get("zram") or {}
    z_mib = zram.get("compr_mib", 0)
    line_mem = (
        f"存储: RAM {m.get('ram_used_gib', '?')}/{m.get('ram_total_gib', '?')} GiB · "
        f"ZRAM {z_mib}M · UFS [{st.get('ufs_scheduler', '?')}/{st.get('read_ahead_kb', '?')}K]"
    )
    if net_info:
        svc_ok = sum(1 for v in net_info["services"].values() if v == "active")
        svc_total = len(net_info["services"])
        conn = net_info.get("connectivity", "?")
        line_net = f"网络: 连通={conn} · {n.get('tcp_congestion_control', '?')}+{n.get('default_qdisc', '?')} · 服务 {svc_ok}/{svc_total} 正常"
    else:
        line_net = f"网络: TCP {n.get('tcp_congestion_control', '?')} + {n.get('default_qdisc', '?')}"
    return line_bat, line_temp, line_mem, line_net


def run_tray() -> int:
