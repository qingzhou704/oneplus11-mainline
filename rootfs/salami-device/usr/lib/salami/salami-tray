        def _on_timer(self) -> bool:
            self._net_tick = (self._net_tick + 1) % 4
            self.refresh(refresh_net=(self._net_tick == 0))
            return True

        def refresh(self, *, refresh_net: bool = False) -> None:
            try:
                status = ctl.collect_status()
                if refresh_net or self._last_net is None:
                    self._last_net = ctl.collect_net_and_services()
            except Exception:  # noqa: BLE001
                return

            self._updating = True
            try:
                self.indicator.set_label(format_indicator_label(status), " 100W · 99°C")
                self.indicator.set_icon_full(choose_indicator_icon(status), "OnePlus 11 状态")

                l1, l2 = format_summary_lines(status, self._last_net)
                self.lbl_sum1.set_label(l1)
                self.lbl_sum2.set_label(l2)

                pmode = status["perf"]["mode"]
                if pmode in self.perf_radios:
                    self.perf_radios[pmode].set_active(True)
                perf_short = {"eco": "节能静音", "balanced": "日常均衡", "performance": "满血性能"}.get(pmode, pmode)
                self.item_perf.set_label(f"性能模式  ({perf_short})")

                end_thr = status["battery"].get("end_threshold_pct") or 80
                rem_s = status["battery"].get("restore_timer_remaining_s") or 0
                if end_thr <= 80:
                    self.charge_radios["80"].set_active(True)
                elif rem_s > 0:
                    target_key = "100_12h" if rem_s > 6 * 3600 else "100_6h"
                    self.charge_radios[target_key].set_active(True)
                elif not any(
                    self.charge_radios[k].get_active() for k in ("100_6h", "100_12h", "100_keep")
                ):
                    self.charge_radios["100_keep"].set_active(True)
                vooc_on = bool(status["battery"].get("vooc_enabled"))
                cool_lv = int(status["battery"].get("vooc_cool_down") or 0)
                v_mode = "slow" if not vooc_on else ("cool" if cool_lv > 0 else "fast")
                self.vooc_radios[v_mode].set_active(True)
                v_txt = {"fast": "闪充", "cool": "温充", "slow": "慢充"}[v_mode]
                rem_txt = ctl.format_duration_short(rem_s) if rem_s else ""
                pow_head = f"剩 {rem_txt}" if rem_txt else f"限 {end_thr}%"
                self.item_power.set_label(f"充电与快充  ({pow_head} · {v_txt})")

                scr_on = str(status["display"].get("dpms", "")).lower() == "on"
                self.chk_screen.set_active(scr_on)

                hbm_sup = bool(status["display"].get("hbm_supported"))
                hbm_on = bool(status["display"].get("hbm_enabled"))
                self.chk_hbm.set_sensitive(hbm_sup)
                self.chk_hbm.set_active(hbm_on if hbm_sup else False)

                cfg_hz = int(status["display"].get("configured_refresh_hz") or status["display"].get("refresh_hz") or 120)
                if cfg_hz in self.ref_radios:
                    self.ref_radios[cfg_hz].set_active(True)

                br_pct = int(status["display"].get("brightness_pct") or 50)
                self.br_radios[nearest_preset(br_pct, BRIGHTNESS_PRESETS)].set_active(True)
                self.item_display.set_label(f"屏幕与刷新率  ({'亮屏' if scr_on else '息屏'} · {cfg_hz}Hz)")

                touch_st = status.get("touch") or {}
                off_pol = str(touch_st.get("off_policy") or "gesture")
                if off_pol in self.toff_radios:
                    self.toff_radios[off_pol].set_active(True)
                glove_sup = bool(touch_st.get("glove_supported"))
                self.chk_glove.set_sensitive(glove_sup)
                self.chk_glove.set_active(bool(touch_st.get("glove_enabled")) if glove_sup else False)

                t_cur = int(status["torch"].get("brightness") or 0)
                if t_cur <= 0:
                    self.torch_radios[0].set_active(True)
                else:
                    self.torch_radios[nearest_preset(t_cur, TORCH_PRESETS[1:])].set_active(True)
                pol_short = {"gesture": "双击亮屏", "sleep": "息屏断触", "active": "单点唤醒"}.get(off_pol, "双击亮屏")
                self.item_touch.set_label(f"触控与手电筒  ({'手电已开' if t_cur > 0 else pol_short})")

                qp = int(status.get("rdp_vaapi_qp") or 22)
                near_qp = min(self.rdp_radios.keys(), key=lambda k: abs(k - qp))
                self.rdp_radios[near_qp].set_active(True)
                self.item_rdp.set_label(f"远程桌面画质  (QP {qp})")

                if self._last_net:
                    mdm = self._last_net.get("modem") or {}
                    if mdm.get("present"):
                        carrier = mdm.get("operator_name") or mdm.get("operator_code") or "蜂窝"
                        sig = f" · {mdm['signal_pct']}%" if mdm.get("signal_pct") is not None else ""
                        self.lbl_modem.set_label(f"5G 基带: {carrier} · {mdm.get('state', '?')}{sig}")
                    else:
                        self.lbl_modem.set_label("5G 基带: 未检测到调制解调器")

                    svcs = self._last_net.get("services") or {}
                    svc_ok = sum(1 for v in svcs.values() if v == "active")
                    self.item_srv.set_label(f"网络与体检  ({self._last_net.get('connectivity', '?')})")
                    self.item_tasks.set_label(f"服务管理  ({svc_ok}/{len(svcs)} 运行中)")
                    for key, (act_item, stop_item, title, act) in self.svc_items.items():
                        verb = "重载" if act == "reload" else "重启"
                        st = svcs.get(key, "?")
                        active = st == "active"
                        act_item.set_label(f"{verb} {title} [运行中]" if active else f"启动 {title} [已停止]")
                        if stop_item is not None:
                            stop_item.set_visible(active)
                            stop_item.set_sensitive(active)
            finally:
                self._updating = False

        def _on_perf_toggled(self, widget: Gtk.RadioMenuItem, mode: str) -> None:
            if self._updating or not widget.get_active():
                return
            try:
                info = ctl.set_perf_profile(mode)
                self._notify("性能档位已切换", info["label"])
            except Exception as exc:  # noqa: BLE001
                self._notify("切换性能模式失败", str(exc))
            self.refresh()

        def _on_charge_toggled(self, widget: Gtk.RadioMenuItem, key: str) -> None:
            if self._updating or not widget.get_active():
                return

            def apply_charge() -> str:
                if key == "80":
                    cmd = [str(CTL_PATH), "charge", "80"]
                elif key == "100_6h":
                    cmd = [str(CTL_PATH), "charge", "100", "--hours", "6"]
                elif key == "100_12h":
                    cmd = [str(CTL_PATH), "charge", "100", "--hours", "12"]
                else:
                    cmd = [str(CTL_PATH), "charge", "100"]
                return subprocess.check_output(cmd, text=True).strip()

            self._run_bg(apply_charge, "已更新充电上限")

        def _on_vooc_mode_toggled(self, widget: Gtk.RadioMenuItem, vkey: str) -> None:
            if self._updating or not widget.get_active():
                return
            try:
                if vkey == "slow":
                    ctl.set_vooc_state("off")
                    self._notify("已切换为 10W 低温慢充护航")
                elif vkey == "cool":
                    ctl.set_vooc_state("on", cool_down=8)
                    self._notify("已切换为 SUPERVOOC 温和限流快充")
                else:
                    ctl.set_vooc_state("on", cool_down=0)
                    self._notify("已切换为 SUPERVOOC 50W 全速闪充")
            except Exception as exc:  # noqa: BLE001
                self._notify("切换快充模式失败", str(exc))
            self.refresh()

        def _on_touch_policy_toggled(self, widget: Gtk.RadioMenuItem, policy: str) -> None:
            if self._updating or not widget.get_active():
                return
            try:
                st = ctl.set_touch_off_policy(policy)
                self._notify("已更新息屏触控策略", st["off_policy_label"])
            except Exception as exc:  # noqa: BLE001
                self._notify("更新息屏触控策略失败", str(exc))
            self.refresh()

        def _on_glove_toggled(self, widget: Gtk.CheckMenuItem) -> None:
            if self._updating:
                return
            try:
                on = ctl.set_touch_glove("on" if widget.get_active() else "off")
                self._notify("已开启手套高灵敏触控" if on else "已关闭手套高灵敏触控")
            except Exception as exc:  # noqa: BLE001
                self._notify("切换手套触控失败", str(exc))
            self.refresh()

        def _on_screen_toggled(self, widget: Gtk.CheckMenuItem) -> None:
            if self._updating:
                return
            want = "on" if widget.get_active() else "off"
            self._run_bg(
                lambda: subprocess.check_output(
                    ctl.build_privileged_command([str(CTL_PATH), "screen", want]), text=True
                ).strip(),
                "已点亮手机物理屏幕" if want == "on" else "已关闭手机物理屏幕",
            )

        def _on_hbm_toggled(self, widget: Gtk.CheckMenuItem) -> None:
            if self._updating:
                return
            try:
                state = ctl.set_hbm_state("on" if widget.get_active() else "off")
                self._notify("已开启阳光屏超亮激发" if state else "已恢复常规屏幕亮度")
            except Exception as exc:  # noqa: BLE001
                self._notify("切换阳光屏 HBM 失败", str(exc))
            self.refresh()

        def _on_brightness_toggled(self, widget: Gtk.RadioMenuItem, pct: int) -> None:
            if self._updating or not widget.get_active():
                return
            try:
                ctl.set_brightness(f"{pct}%")
            except Exception as exc:  # noqa: BLE001
                self._notify("调节亮度失败", str(exc))
            self.refresh()

        def _on_torch_toggled(self, widget: Gtk.RadioMenuItem, level: int) -> None:
            if self._updating or not widget.get_active():
                return
            try:
                ctl.set_torch("off" if level == 0 else str(level))
            except Exception as exc:  # noqa: BLE001
                self._notify("控制手电筒失败", str(exc))
            self.refresh()

        def _on_refresh_toggled(self, widget: Gtk.RadioMenuItem, hz: int) -> None:
            if self._updating or not widget.get_active():
