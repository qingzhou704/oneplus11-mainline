def format_indicator_label(status: dict[str, Any]) -> str:
    bat = status.get("battery") or {}
    therm = status.get("thermals_c") or {}

    cap = bat.get("capacity_pct")
    watts = bat.get("power_w") or 0.0
    bat_state = bat.get("status", "")
    cpu_t = therm.get("cpu_max")

    if watts >= 0.8 and bat_state == "Charging":
        power_part = f"{watts:.0f}W"
    elif cap is not None:
        power_part = f"{cap}%"
    else:
        power_part = "OP11"

    temp_part = f" · {cpu_t:.0f}°C" if cpu_t is not None else ""
    return f" {power_part}{temp_part}"


def choose_indicator_icon(status: dict[str, Any]) -> str:
    bat = status.get("battery") or {}
    perf = (status.get("perf") or {}).get("mode", "balanced")
    watts = bat.get("power_w") or 0.0
    if watts >= 5.0 and bat.get("status") == "Charging":
        return "battery-good-charging-symbolic"
    if perf == "performance":
        return "power-profile-performance-symbolic"
    if perf == "eco":
        return "power-profile-power-saver-symbolic"
    return "phone-symbolic"


def nearest_preset(value: int, presets: tuple[tuple[int, str], ...]) -> int:
    return min(presets, key=lambda item: abs(item[0] - value))[0]


def format_summary_lines(status: dict[str, Any], net_info: dict[str, Any] | None = None) -> tuple[str, str]:
    b = status["battery"]
    t = status["thermals_c"]
    m = status["memory"]

    watts = abs(float(b.get("power_w") or 0.0))
    b_status = str(b.get("status") or "")
    if watts < 0.1:
        w_str = "0 W"
    elif b_status == "Discharging":
        w_str = f"放电 {watts:.1f} W"
    elif b_status == "Charging":
        w_str = f"充电 {watts:.1f} W"
    else:
        w_str = f"{watts:.1f} W"
    rem_s = b.get("restore_timer_remaining_s")
    rem_txt = ctl.format_duration_short(rem_s) if rem_s else ""
    lim_str = (
        f"限充 {b.get('end_threshold_pct', 100)}% · 剩 {rem_txt}"
        if rem_txt
        else f"限充 {b.get('end_threshold_pct', 80)}%"
    )
    line_1 = (
        f"电池 {b.get('capacity_pct', '?')}% ({lim_str}) "
        f"· {w_str} · {b.get('temp_c', '?')} °C"
    )
    svc_part = ""
    if net_info and net_info.get("services"):
        svc_ok = sum(1 for v in net_info["services"].values() if v == "active")
        svc_total = len(net_info["services"])
        svc_part = f" · 服务 {svc_ok}/{svc_total}"
    line_2 = (
        f"CPU {t.get('cpu_max', '?')} °C · RAM {m.get('ram_used_gib', '?')}/{m.get('ram_total_gib', '?')}G{svc_part}"
    )
    return line_1, line_2


def run_tray() -> int:
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3, Gio, GLib, Gtk

    class SalamiTrayApp:
        def __init__(self) -> None:
            self._updating = False
            self._last_net: dict[str, Any] | None = None
            self._net_tick = 0

            self.indicator = AyatanaAppIndicator3.Indicator.new(
                "salami-control-center",
                "phone-symbolic",
                AyatanaAppIndicator3.IndicatorCategory.HARDWARE,
            )
            self.indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
            self.indicator.set_title("一加 11 控制台")

            self.menu = Gtk.Menu()
            self._build_menu()
            self.indicator.set_menu(self.menu)

            self.refresh(refresh_net=True)
            GLib.timeout_add_seconds(15, self._on_timer)

        def _notify(self, summary: str, body: str = "") -> None:
            try:
                bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
                bus.call_sync(
                    "org.freedesktop.Notifications",
                    "/org/freedesktop/Notifications",
                    "org.freedesktop.Notifications",
                    "Notify",
                    GLib.Variant(
                        "(susssasa{sv}i)",
                        ("一加 11 控制台", 0, "phone-symbolic", summary, body, [], {}, 2500),
                    ),
                    None,
                    Gio.DBusCallFlags.NONE,
                    1500,
                    None,
                )
            except GLib.Error:
                pass

        def _run_bg(self, fn, done_title: str | None = None) -> None:
            def worker() -> None:
                err: str | None = None
                detail = ""
                try:
                    res = fn()
                    if isinstance(res, str):
                        detail = res
                except Exception as exc:  # noqa: BLE001
                    err = str(exc)

                def finish() -> bool:
                    self.refresh(refresh_net=True)
                    if err:
                        self._notify("操作失败", err)
                    elif done_title:
                        self._notify(done_title, detail)
                    return False

                GLib.idle_add(finish)

            threading.Thread(target=worker, daemon=True).start()

