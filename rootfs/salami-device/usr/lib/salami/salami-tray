            try:
                _qp, desc = ctl.set_rdp_qp(preset_key)
                self._notify("已更新远程桌面硬编预设", f"{desc}（下次重连生效）")
            except Exception as exc:  # noqa: BLE001
                self._notify("设置 RDP 画质失败", str(exc))
            self.refresh()

        def _on_service_primary(self, _widget: Gtk.MenuItem, unit: str, title: str, default_act: str) -> None:
            svc_key = unit.removesuffix(".service")
            svcs = (self._last_net or {}).get("services") or {}
            act = default_act if svcs.get(svc_key) == "active" else "start"
            self._on_service_action(_widget, unit, title, act)

        def _on_service_action(self, _widget: Gtk.MenuItem, unit: str, title: str, act: str) -> None:
            verb = {"start": "启动", "stop": "停止", "restart": "重启", "reload": "重载"}.get(act, act)
            self._run_bg(
                lambda: subprocess.check_call(
                    ctl.build_privileged_command([str(CTL_PATH), "service", unit, act])
                )
                or f"{title} 已完成{verb}",
                f"已{verb} {title}",
            )

