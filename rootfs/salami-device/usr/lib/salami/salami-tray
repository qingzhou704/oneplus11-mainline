        def _on_timer(self) -> bool:
            self._net_tick = (self._net_tick + 1) % 5
            self.refresh(refresh_net=(self._net_tick == 0))
            return True

        def refresh(self, *, refresh_net: bool = False) -> None:
            status = ctl.collect_status()
            if refresh_net or self._last_net is None:
                self._last_net = ctl.collect_net_and_services()

            self.indicator.set_icon_full(choose_indicator_icon(status), "一加 11 状态")
            self.indicator.set_label(format_indicator_label(status), " 🚀 100% · 99°C")

            l_bat, l_temp, l_mem, l_net = format_summary_lines(status, self._last_net)
            self.lbl_bat.set_label(l_bat)
            self.lbl_temp.set_label(l_temp)
            self.lbl_mem.set_label(l_mem)
            self.lbl_net.set_label(l_net)

            self._updating = True
            try:
                perf_mode = status["perf"]["mode"]
                if perf_mode in self.perf_radios:
                    self.perf_radios[perf_mode].set_active(True)

                end_thr = status["battery"].get("end_threshold_pct") or 80
                if end_thr <= 80:
                    self.charge_radios["80"].set_active(True)
                elif not any(
                    self.charge_radios[k].get_active() for k in ("100_6h", "100_12h", "100_keep")
                ):
                    self.charge_radios["100_keep"].set_active(True)

                self.chk_vooc.set_active(bool(status["battery"].get("vooc_enabled")))

                dpms_on = str(status["display"].get("dpms", "")).lower() == "on"
                self.chk_screen.set_active(dpms_on)

                near_br = nearest_preset(int(status["display"].get("brightness_pct") or 35), BRIGHTNESS_PRESETS)
                if near_br in self.br_radios:
                    self.br_radios[near_br].set_active(True)

                hbm_sup = bool(status["display"].get("hbm_supported"))
                self.chk_hbm.set_sensitive(hbm_sup)
                self.chk_hbm.set_active(bool(status["display"].get("hbm_enabled")) if hbm_sup else False)
                self.chk_hbm.set_label(
                    "☀️ 阳光屏户外超亮激发 (HBM)" if hbm_sup else "☀️ 阳光屏户外超亮 (重启加载新模块后可用)"
                )

                torch_lvl = int(status["torch"].get("brightness") or 0)
                self.chk_torch.set_active(torch_lvl > 0)
                near_torch = 0 if torch_lvl == 0 else nearest_preset(torch_lvl, TORCH_PRESETS[1:])
                if near_torch in self.torch_radios:
                    self.torch_radios[near_torch].set_active(True)

                cfg_hz = int(status["display"].get("configured_refresh_hz") or status["display"].get("refresh_hz") or 120)
                if cfg_hz in self.ref_radios:
                    self.ref_radios[cfg_hz].set_active(True)

                touch_st = status.get("touch") or {}
                off_pol = str(touch_st.get("off_policy") or "gesture")
                if off_pol in self.toff_radios:
                    self.toff_radios[off_pol].set_active(True)
                glove_sup = bool(touch_st.get("glove_supported"))
                self.chk_glove.set_sensitive(glove_sup)
                self.chk_glove.set_active(bool(touch_st.get("glove_enabled")) if glove_sup else False)

                qp = int(status.get("rdp_vaapi_qp") or 22)
                near_qp = min(self.rdp_radios.keys(), key=lambda k: abs(k - qp))
                self.rdp_radios[near_qp].set_active(True)

                if self._last_net:
                    mdm = self._last_net.get("modem") or {}
                    if mdm.get("present"):
                        carrier = mdm.get("operator_name") or mdm.get("operator_code") or "蜂窝"
                        sig = f" · {mdm['signal_pct']}%" if mdm.get("signal_pct") is not None else ""
                        rat = f" ({mdm['access_tech']})" if mdm.get("access_tech") else ""
                        self.lbl_modem.set_label(
                            f"📶 5G 基带: {carrier} · {mdm.get('state', '?')}{rat}{sig}"
                        )
                    else:
                        self.lbl_modem.set_label("📶 5G 基带: 未检测到调制解调器")

                    svcs = self._last_net.get("services") or {}
                    for unit, (mi, title, act) in self.srv_items.items():
                        key = unit.removesuffix(".service")
                        ok = svcs.get(key) == "active"
                        mark = "✓ 运行中" if ok else f"✗ {svcs.get(key, '未知')}"
                        verb = "重载" if act == "reload" else "重启"
                        mi.set_label(f"{mark} · {title} (点击{verb})")
            finally:
                self._updating = False

        def _on_perf_toggled(self, widget: Gtk.RadioMenuItem, mode: str) -> None:
            if self._updating or not widget.get_active():
                return
            try:
                info = ctl.set_perf_profile(mode)
                self._notify("已切换性能模式", info["label"])
            except Exception as exc:  # noqa: BLE001
                self._notify("切换性能模式失败", str(exc))
            self.refresh()

        def _on_charge_toggled(self, widget: Gtk.RadioMenuItem, key: str) -> None:
            if self._updating or not widget.get_active():
                return
            if key == "80":
                args = ["charge", "80"]
                title = "已恢复 75–80% 日常护航限充"
            elif key == "100_6h":
                args = ["charge", "100", "--hours", "6"]
                title = "已开启 100% 满充（6 小时后自动恢复 80%）"
            elif key == "100_12h":
                args = ["charge", "100", "--hours", "12"]
                title = "已开启 100% 满充（12 小时后自动恢复 80%）"
            else:
                args = ["charge", "100"]
                title = "已设为 100% 满充上限"
            self._run_bg(
                lambda: subprocess.check_output([str(CTL_PATH), *args], text=True).strip(),
                title,
            )

