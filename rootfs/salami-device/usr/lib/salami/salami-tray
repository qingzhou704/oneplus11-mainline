        def _on_service_action(self, _widget: Gtk.MenuItem, unit: str, title: str, act: str) -> None:
            verb = "重载" if act == "reload" else "重启"
            self._run_bg(
                lambda: subprocess.check_call(
                    ctl.build_privileged_command(["/usr/bin/systemctl", act, unit])
                )
                or f"{title} 已完成{verb}",
                f"已{verb} {title}",
