// GIS may invoke only this root helper; it validates caller and target again.
polkit.addRule(function(action, subject) {
    if (subject.local && subject.active &&
        subject.isInGroup('gnome-initial-setup') &&
        action.id === 'org.freedesktop.policykit.exec' &&
        action.lookup('program') === '/usr/lib/salami/enable-passwordless-local') {
        return polkit.Result.YES;
    }
});

// Explicit first-run opt-in grants local active administration, never remote sessions.
polkit.addRule(function(action, subject) {
    if (subject.local && subject.active &&
        subject.isInGroup('salami-passwordless')) {
        // Recheck the account database, not stale supplementary groups in an
        // already-running session after the user has set a password.
        try {
            if (polkit.spawn(['/usr/lib/salami/enable-passwordless-local',
                              '--check-local', subject.user]).trim() === 'yes') {
                return polkit.Result.YES;
            }
        } catch (error) {
            return polkit.Result.NOT_HANDLED;
        }
    }
});
