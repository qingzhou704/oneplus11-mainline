#!/usr/bin/python3
"""GIS opt-in local passwordless policy; --reconcile revokes it after passwd."""

from contextlib import contextmanager
import fcntl
import grp
import os
import pwd
import re
import stat
import subprocess
import sys

GROUP = "salami-passwordless"
LOCK = "/run/lock/salami-passwordless.lock"
PENDING = "/var/lib/salami/passwordless-pending"
ACCOUNTS = "org.freedesktop.Accounts"
ROOT_PATH = "/org/freedesktop/Accounts"
USERNAME = re.compile(r"[a-z_][a-z0-9_-]{0,31}\Z")
OBJECT_REPLY = re.compile(r"\(objectpath '(/org/freedesktop/Accounts/User[0-9]+)',\)\Z")


def local_users():
    # NSS may include remote accounts: the target must actually be in /etc/passwd.
    with open("/etc/passwd", encoding="utf-8") as stream:
        return [pwd.struct_passwd((f[0], f[1], int(f[2]), int(f[3]), *f[4:]))
                for line in stream if (f := line.rstrip("\n").split(":")) and len(f) == 7]


def member(user, group):
    return user.pw_gid == group.gr_gid or user.pw_name in group.gr_mem


def ordinary(user):
    return 1000 <= user.pw_uid <= 59999 and USERNAME.fullmatch(user.pw_name)


@contextmanager
def policy_lock():
    # O_NOFOLLOW plus inode checks prevent a precreated link in /run/lock.
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        info = os.fstat(fd)
        if (info.st_uid != 0 or not stat.S_ISREG(info.st_mode)
                or info.st_mode & 0o022 or info.st_nlink != 1):
            raise ValueError("unsafe passwordless lock file")
        fcntl.flock(fd, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


@contextmanager
def pending_directory():
    # Walk by directory fd, rejecting symlinks and non-root writable ancestors.
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for component in PENDING.strip("/").split("/"):
            try:
                os.mkdir(component, 0o700, dir_fd=fd)
                os.fsync(fd)
            except FileExistsError:
                pass
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                            | os.O_CLOEXEC, dir_fd=fd)
            info = os.fstat(child)
            if info.st_uid != 0 or info.st_mode & 0o022:
                os.close(child)
                raise ValueError("unsafe passwordless pending directory")
            os.close(fd)
            fd = child
        yield fd
    finally:
        os.close(fd)


def pending_names():
    with pending_directory() as directory:
        names = os.listdir(directory)
        for name in names:
            if not USERNAME.fullmatch(name):
                raise ValueError("invalid pending username")
            info = os.stat(name, dir_fd=directory, follow_symlinks=False)
            if (info.st_uid != 0 or not stat.S_ISREG(info.st_mode)
                    or info.st_mode & 0o022 or info.st_nlink != 1):
                raise ValueError("unsafe passwordless pending marker")
        return set(names)


def mark_pending(name):
    if not USERNAME.fullmatch(name):
        raise ValueError("invalid pending username")
    with pending_directory() as directory:
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
                     0o600, dir_fd=directory)
        try:
            info = os.fstat(fd)
            if (info.st_uid != 0 or not stat.S_ISREG(info.st_mode)
                    or info.st_mode & 0o022 or info.st_nlink != 1):
                raise ValueError("unsafe passwordless pending marker")
            os.fsync(fd)
        finally:
            os.close(fd)
        os.fsync(directory)


def clear_pending(name):
    if not USERNAME.fullmatch(name):
        raise ValueError("invalid pending username")
    with pending_directory() as directory:
        try:
            os.unlink(name, dir_fd=directory)
        except FileNotFoundError:
            return
        os.fsync(directory)


def check_local(name):
    # Deliberately unprivileged: do not read shadow or use a session's stale groups.
    if not USERNAME.fullmatch(name):
        return False
    target = next((u for u in local_users() if u.pw_name == name), None)
    return bool(target is not None and ordinary(target)
                and member(target, grp.getgrnam("sudo"))
                and member(target, grp.getgrnam(GROUP)))


def run(argv):
    return subprocess.run(argv, check=True, capture_output=True, text=True,
                          env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}).stdout.strip()


def dbus(path, method, *args):
    return run(["/usr/bin/gdbus", "call", "--system", "--dest", ACCOUNTS,
                "--object-path", path, "--method", method, *args])


def account_path(name):
    reply = dbus(ROOT_PATH, ACCOUNTS + ".FindUserByName", name)
    match = OBJECT_REPLY.fullmatch(reply)
    if not match:
        raise ValueError("AccountsService returned an unsafe object path")
    return match[1]


def enable(name):
    caller_uid = os.environ.get("PKEXEC_UID", "")
    if not re.fullmatch(r"[0-9]+", caller_uid) or int(caller_uid) == 0:
        raise ValueError("only the initial-setup caller is allowed")
    caller = pwd.getpwuid(int(caller_uid))
    if not member(caller, grp.getgrnam("gnome-initial-setup")):
        raise ValueError("caller is not in gnome-initial-setup")
    if not USERNAME.fullmatch(name) or name == "root":
        raise ValueError("invalid target username")
    users = local_users()
    target = next((u for u in users if u.pw_name == name), None)
    if target is None or not ordinary(target):
        raise ValueError("target must be a local ordinary user")
    if sum(1000 <= u.pw_uid <= 59999 for u in users) != 1:
        raise ValueError("target must be the only ordinary local user")
    if not member(target, grp.getgrnam("sudo")):
        raise ValueError("target must be in sudo")
    grp.getgrnam(GROUP)  # Missing installation prerequisites must fail before changes.
    if name in pending_names():
        raise ValueError("finish pending revocation before enabling passwordless login")
    path = account_path(name)
    dbus(path, ACCOUNTS + ".User.SetPasswordMode", "2")
    dbus(path, ACCOUNTS + ".User.SetAutomaticLogin", "true")
    run(["/usr/sbin/usermod", "-a", "-G", GROUP, name])
    # pending_names() above checked root ownership of this parent directory.
    # Only successful opt-in arms the watcher; adduser's shadow burst must not.
    run(["/usr/bin/touch", "/var/lib/salami/passwordless-opted-in"])


def reconcile():
    group = grp.getgrnam(GROUP)
    users = {u.pw_name: u for u in local_users()}
    pending = pending_names()
    names = {u.pw_name for u in users.values() if member(u, group)} | pending
    if not names:
        return
    with open("/etc/shadow", encoding="utf-8") as stream:
        passwords = {f[0]: f[1] for line in stream
                     if len(f := line.rstrip("\n").split(":")) >= 2}
    failed = False
    for name in sorted(names):
        try:
            if not USERNAME.fullmatch(name):
                raise ValueError("invalid pending username")
            user = users.get(name)
            if user is None:
                # Deleted local accounts cannot log in; do not recreate them via D-Bus.
                clear_pending(name)
                continue
            if not ordinary(user):
                raise ValueError("passwordless revocation target is not an ordinary account")
            if name not in pending and passwords[name] == "":
                continue
            # Persist before dropping membership: a failed D-Bus call must remain retryable.
            mark_pending(name)
            if member(user, group):
                if user.pw_gid == group.gr_gid:
                    raise ValueError("cannot revoke a passwordless primary group")
                run(["/usr/bin/gpasswd", "-d", name, GROUP])
            path = account_path(name)
            dbus(path, ACCOUNTS + ".User.SetAutomaticLogin", "false")
            clear_pending(name)
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
            print(f"reconcile {name}: {error}", file=sys.stderr)
            failed = True
    if failed:
        raise ValueError("one or more passwordless accounts could not be reconciled")


def main(argv=None):
    args = sys.argv[1:] if argv is None else argv
    try:
        if len(args) == 2 and args[0] == "--check-local":
            if check_local(args[1]):
                print("yes")
                return 0
            return 1
        if os.geteuid() != 0:
            raise ValueError("must run as root")
        if args == ["--reconcile"]:
            with policy_lock():
                reconcile()
        elif len(args) == 1 and not args[0].startswith("-"):
            with policy_lock():
                enable(args[0])
        else:
            raise ValueError("usage: enable-passwordless-local USERNAME | --reconcile | --check-local USERNAME")
        return 0
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f"enable-passwordless-local: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
