[Unit]
Description=Revoke local passwordless policy after a password is set
After=accounts-daemon.service
# Account creation edits shadow repeatedly before anyone opts in. Skipped
# conditions do not consume the service start limit.
ConditionPathExists=/var/lib/salami/passwordless-opted-in

[Service]
Type=oneshot
User=root
ExecStart=/usr/lib/salami/enable-passwordless-local --reconcile

[Install]
WantedBy=multi-user.target
