# SPDX-License-Identifier: GPL-2.0
# Merge after defconfig, mobile.config, qcom.config, sm8550.config.
CONFIG_ARM64_FDT_HANDOFF=y
CONFIG_BUILTIN_DTB_NAME="qcom/sm8550-oneplus-salami"
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_FORCE=y
# INITRAMFS_SOURCE is injected by the main agent at build time.
CONFIG_CMDLINE="rdinit=/init loglevel=7 panic=10 oops=panic msm.separate_gpu_kms=1"
CONFIG_CMDLINE_FORCE=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Early dependencies must not need modules from storage.
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_INTERCONNECT_QCOM_SM8550=y
CONFIG_INPUT_PM8941_PWRKEY=y
# gcc/rpmhpd sync_state waits for every consumer; a RAM image has no modules.
CONFIG_SM_VIDEOCC_8550=y
CONFIG_SM_CAMCC_8550=y
# Software reboot into the bootloader needs the reboot-mode driver.
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
# CONFIG_USB_DWC3_HOST is not set
CONFIG_USB_DWC3_DUAL_ROLE=y
# CONFIG_USB_DWC3_GADGET is not set
# UCSI drives the connector role; keep the same USB 2.0 PHY for both roles.
CONFIG_USB_ROLE_SWITCH=y
# USB dock peripherals use upstream class drivers; data and power roles stay independent.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=m
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
# Battery, charger and Type-C controller live in the ADSP.
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_UCSI_PMIC_GLINK=m
CONFIG_BATTERY_QCOM_BATTMGR=m
# USB connector / subboard thermistors on the PMK8550 ADC.
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_SENSORS_IIO_HWMON=m
# Distribution firmware (linux-firmware) is zstd-compressed.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# Native display can be probed after the USB debug channel is available.
CONFIG_DRM_MSM=m
CONFIG_DRM_PANEL_SAMSUNG_AMB670YF07=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_I2C=m
# Thermal control, volume-down GPIO key, linear motor haptics, Iris3 video codec, and CMA.
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m
CONFIG_GENERIC_ADC_THERMAL=m
CONFIG_THERMAL_STATISTICS=y
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_CMA_SIZE_MBYTES=128
# BBR congestion control and Fair Queue pacing for server / tunnel / wireless links.
CONFIG_TCP_CONG_BBR=m
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_FQ_CODEL=m
# Netfilter compatibility modules for ufw, iptables-nft, Docker, and rate limiting.
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
# Transparent proxy (TPROXY / SOCKET), Redirect NAT, IPSet, USB 5GbE, PlayStation HID, and LED triggers.
CONFIG_NFT_TPROXY=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_REDIR=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_NETFILTER_XT_SET=m
CONFIG_USB_NET_AQC111=m
CONFIG_HID_PLAYSTATION=m
CONFIG_LEDS_TRIGGER_NETDEV=m
CONFIG_LEDS_TRIGGER_TRANSIENT=m
